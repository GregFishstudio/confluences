@page
@model ResetPasswordConfirmationModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Mot de passe changé";
}

<br /><br /><br /><br /><br /><br />
<div class="container">
    <div class="row">
        <div class="col-lg-5 col-md-7 col-sm-10 ml-auto mr-auto">
            <div class="card card-login">
                <div class="card-header card-header-primary text-center">
                    <h4 class="card-title">Mot de passe changé</h4>
                </div>
                <div class="card-body">
                    <p>Votre nouveau mot de passe est enregistré. Vous pouvez vous connecter avec.</p>
                    <a class="btn btn-primary btn-block" href="@((Configuration["URLVueJsGestionStagiaire"] ?? "/") + "login")">Se connecter</a>
                </div>
            </div>
        </div>
    </div>
</div>
