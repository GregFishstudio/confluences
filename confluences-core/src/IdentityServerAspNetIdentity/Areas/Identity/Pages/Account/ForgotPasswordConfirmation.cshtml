@page
@model ForgotPasswordConfirmation
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Lien envoyé";
}

<br /><br /><br /><br /><br /><br />
<div class="container">
    <div class="row">
        <div class="col-lg-5 col-md-7 col-sm-10 ml-auto mr-auto">
            <div class="card card-login">
                <div class="card-header card-header-primary text-center">
                    <h4 class="card-title">Vérifiez votre messagerie</h4>
                </div>
                <div class="card-body">
                    <p>
                        Si ce compte existe, un e-mail vient d'être envoyé à son adresse, avec un lien pour
                        choisir un nouveau mot de passe.
                    </p>
                    <p class="text-muted">Rien reçu après quelques minutes ? Regardez dans les indésirables, ou demandez à l'administratrice.</p>
                    <a class="btn btn-link btn-block" href="@((Configuration["URLVueJsGestionStagiaire"] ?? "/") + "login")">Retour à la connexion</a>
                </div>
            </div>
        </div>
    </div>
</div>
