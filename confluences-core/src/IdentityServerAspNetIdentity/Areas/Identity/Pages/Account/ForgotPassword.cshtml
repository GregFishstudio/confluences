@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}

<br /><br /><br /><br /><br /><br />
<div class="container">
    <div class="row">
        <div class="col-lg-5 col-md-7 col-sm-10 ml-auto mr-auto">
            <div class="card card-login">
                <div class="card-header card-header-primary text-center">
                    <h4 class="card-title">Mot de passe oublié</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Indiquez l'adresse e-mail ou l'identifiant de votre compte : vous recevrez un lien
                        pour choisir un nouveau mot de passe.
                    </p>
                    @if (!string.IsNullOrEmpty(Model.Erreur))
                    {
                        <div class="alert alert-danger" role="alert">@Model.Erreur</div>
                    }
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                        <div class="form-group">
                            <label asp-for="Input.Identifiant"></label>
                            <input asp-for="Input.Identifiant" class="form-control" autocomplete="username" autofocus />
                            <span asp-validation-for="Input.Identifiant" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">Envoyer le lien</button>
                        <a class="btn btn-link btn-block" href="@Model.UrlConnexion">Retour à la connexion</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
