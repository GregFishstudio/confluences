@page
@model ChangePasswordModel
@{
    // Page autonome (même présentation que la connexion), sans le menu « Manage your account ».
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Changer mon mot de passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<br /><br /><br /><br /><br /><br />
<div class="container">
    <div class="row">
        <div class="col-lg-5 col-md-7 col-sm-10 ml-auto mr-auto">
            <div class="card card-login">
                <div class="card-header card-header-primary text-center">
                    <h4 class="card-title">Changer mon mot de passe</h4>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.NomUtilisateur))
                    {
                        <p class="text-muted mb-3">Compte : <strong>@Model.NomUtilisateur</strong></p>
                    }

                    @if (!string.IsNullOrEmpty(Model.StatusMessage))
                    {
                        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
                    }

                    <form id="change-password-form" method="post">
                        <input type="hidden" asp-for="Retour" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <div class="form-group">
                            <label asp-for="Input.OldPassword"></label>
                            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" autofocus />
                            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.NewPassword"></label>
                            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                            <small class="form-text text-muted">@Model.Regles Choisissez un mot de passe personnel : ne le partagez pas avec vos collègues.</small>
                            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.ConfirmPassword"></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">Changer le mot de passe</button>
                        <a class="btn btn-link btn-block" href="@Model.UrlRetour">Retour à l'application</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

