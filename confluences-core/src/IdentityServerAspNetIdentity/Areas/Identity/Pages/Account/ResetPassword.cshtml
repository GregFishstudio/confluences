@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Nouveau mot de passe";
}

<br /><br /><br /><br /><br /><br />
<div class="container">
    <div class="row">
        <div class="col-lg-5 col-md-7 col-sm-10 ml-auto mr-auto">
            <div class="card card-login">
                <div class="card-header card-header-primary text-center">
                    <h4 class="card-title">Choisir un nouveau mot de passe</h4>
                </div>
                <div class="card-body">
                    @if (Model.LienInvalide)
                    {
                        <div class="alert alert-warning" role="alert">
                            Ce lien est incomplet. Ouvrez le lien reçu par e-mail en entier, ou demandez-en un nouveau.
                        </div>
                        <a class="btn btn-primary btn-block" asp-page="./ForgotPassword">Demander un nouveau lien</a>
                    }
                    else
                    {
                        <p class="text-muted mb-3">Compte : <strong>@Model.Input.Email</strong></p>
                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                            <input asp-for="Input.Code" type="hidden" />
                            <input asp-for="Input.Email" type="hidden" />
                            <div class="form-group">
                                <label asp-for="Input.Password"></label>
                                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" autofocus />
                                <small class="form-text text-muted">@Model.Regles Choisissez un mot de passe personnel : ne le partagez pas avec vos collègues.</small>
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Input.ConfirmPassword"></label>
                                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-primary btn-block">Enregistrer le mot de passe</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
