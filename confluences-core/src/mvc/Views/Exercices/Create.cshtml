@model mvc.Models.Exercice

@{
    ViewData["Title"] = "Ajouter un exercice";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }
    .hw-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
    .hw-topbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem; border-bottom: 1px solid #f1f3f9; gap: 12px; flex-wrap: wrap; }
    .hw-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 4px; }
    .hw-title { font-family: 'Lora', serif; font-size: 22px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .hw-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #6c757d; text-decoration: none; border: 1px solid #eef0f7; border-radius: 10px; padding: 7px 14px; transition: all 0.15s; }
    .hw-back:hover { background: #f8f9fc; color: #1a1a2e; text-decoration: none; }
    .hw-form-body { padding: 1.5rem; }
    .hw-section { margin-bottom: 1.5rem; }
    .hw-section-title { font-size: 11px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: #aaa; margin: 0 0 10px; }
    .hw-media-block { background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 12px; padding: 14px 16px; margin-bottom: 1rem; }
    .hw-media-block .hw-or { font-size: 11px; color: #aaa; text-transform: uppercase; letter-spacing: 0.06em; margin: 8px 0; }
    .hw-field { margin-bottom: 1rem; }
    .hw-label { display: block; font-size: 12px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: #aaa; margin-bottom: 6px; }
    .hw-input, .hw-select { width: 100%; background: #fff; border: 1px solid #eef0f7; border-radius: 10px; padding: 9px 14px; font-size: 13px; color: #1a1a2e; font-family: 'DM Sans', sans-serif; outline: none; transition: border-color 0.15s; appearance: none; -webkit-appearance: none; }
    .hw-input:focus, .hw-select:focus { border-color: #c0c8e8; box-shadow: 0 0 0 3px rgba(78,115,223,0.08); }
    .hw-select-wrap { position: relative; }
    .hw-select-wrap::after { content: '\f078'; font-family: 'Font Awesome 5 Free'; font-weight: 900; position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 11px; color: #aaa; pointer-events: none; }
    .hw-file-btn { display: inline-flex; align-items: center; gap: 6px; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 8px; padding: 7px 14px; font-size: 13px; color: #6c757d; cursor: pointer; transition: all 0.15s; }
    .hw-file-btn:hover { background: #eef0f7; color: #1a1a2e; }
    .hw-file-name { font-size: 12px; color: #aaa; margin-left: 6px; }
    .hw-checkbox-field { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; cursor: pointer; margin-bottom: 1rem; }
    .hw-checkbox-field input[type="checkbox"] { width: 16px; height: 16px; accent-color: #1a1a2e; cursor: pointer; }
    .hw-checkbox-label { font-size: 13px; color: #1a1a2e; cursor: pointer; margin: 0; }
    .hw-validation { font-size: 12px; color: #A32D2D; margin-top: 4px; }
    .hw-btn-save { display: inline-flex; align-items: center; gap: 6px; background: #1a1a2e; color: #fff; border: none; border-radius: 10px; padding: 9px 20px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: opacity 0.15s; }
    .hw-btn-save:hover { opacity: 0.8; }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card" style="max-width:660px;">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Exercices</p>
                <h1 class="hw-title">Ajouter un exercice</h1>
            </div>
            <a href="javascript:history.back()" class="hw-back">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>

        <form enctype="multipart/form-data" asp-action="Create" class="hw-form-body">
            <div asp-validation-summary="ModelOnly" class="hw-validation" style="margin-bottom:1rem;"></div>

            <div class="hw-section">
                <p class="hw-section-title">Vidéo</p>
                <div class="hw-media-block">
                    <div class="hw-field">
                        <label asp-for="VideoLink" class="hw-label"></label>
                        <input asp-for="VideoLink" class="hw-input" placeholder="https://..." />
                        <span asp-validation-for="VideoLink" class="hw-validation"></span>
                    </div>
                    <p class="hw-or">ou uploader un fichier</p>
                    <label class="hw-file-btn">
                        <i class="fas fa-paperclip"></i> Choisir une vidéo
                        <input name="fileVideo" type="file" multiple class="inputFileHidden" style="display:none;" />
                    </label>
                </div>
            </div>

            <div class="hw-section">
                <p class="hw-section-title">Audio 1</p>
                <div class="hw-media-block">
                    <div class="hw-field">
                        <label asp-for="AudioLink" class="hw-label"></label>
                        <input asp-for="AudioLink" class="hw-input" placeholder="https://..." />
                        <span asp-validation-for="AudioLink" class="hw-validation"></span>
                    </div>
                    <p class="hw-or">ou uploader un fichier</p>
                    <label class="hw-file-btn">
                        <i class="fas fa-paperclip"></i> Choisir un mp3
                        <input name="fileAudio" type="file" multiple class="inputFileHidden" style="display:none;" />
                    </label>
                </div>
            </div>

            <div class="hw-section">
                <p class="hw-section-title">Audio 2</p>
                <div class="hw-media-block">
                    <div class="hw-field">
                        <label asp-for="AudioLinkSecond" class="hw-label"></label>
                        <input asp-for="AudioLinkSecond" class="hw-input" placeholder="https://..." />
                        <span asp-validation-for="AudioLinkSecond" class="hw-validation"></span>
                    </div>
                    <p class="hw-or">ou uploader un fichier</p>
                    <label class="hw-file-btn">
                        <i class="fas fa-paperclip"></i> Choisir un mp3
                        <input name="fileAudioSecond" type="file" multiple class="inputFileHidden" style="display:none;" />
                    </label>
                </div>
            </div>

            <div class="hw-section">
                <p class="hw-section-title">Audio 3</p>
                <div class="hw-media-block">
                    <div class="hw-field">
                        <label asp-for="AudioLinkThird" class="hw-label"></label>
                        <input asp-for="AudioLinkThird" class="hw-input" placeholder="https://..." />
                        <span asp-validation-for="AudioLinkThird" class="hw-validation"></span>
                    </div>
                    <p class="hw-or">ou uploader un fichier</p>
                    <label class="hw-file-btn">
                        <i class="fas fa-paperclip"></i> Choisir un mp3
                        <input name="fileAudioThird" type="file" multiple class="inputFileHidden" style="display:none;" />
                    </label>
                </div>
            </div>

            <div class="hw-section">
                <p class="hw-section-title">Fichier exercice</p>
                <div class="hw-media-block">
                    <div class="hw-field">
                        <label asp-for="ExerciceLink" class="hw-label"></label>
                        <input asp-for="ExerciceLink" class="hw-input" placeholder="https://..." />
                        <span asp-validation-for="ExerciceLink" class="hw-validation"></span>
                    </div>
                    <p class="hw-or">ou uploader un fichier</p>
                    <label class="hw-file-btn">
                        <i class="fas fa-paperclip"></i> Choisir un fichier
                        <input name="files" type="file" class="inputFileHidden" style="display:none;" />
                    </label>
                </div>
            </div>

            <div class="hw-section">
                <p class="hw-section-title">Correction</p>
                <div class="hw-field">
                    <label asp-for="CorrectionDate" class="hw-label"></label>
                    <input asp-for="CorrectionDate" type="text" class="hw-input datetimepicker" />
                    <span asp-validation-for="CorrectionDate" class="hw-validation"></span>
                </div>
                <div class="hw-media-block">
                    <div class="hw-field">
                        <label asp-for="CorrectionLink" class="hw-label"></label>
                        <input asp-for="CorrectionLink" class="hw-input" placeholder="https://..." />
                        <span asp-validation-for="CorrectionLink" class="hw-validation"></span>
                    </div>
                    <p class="hw-or">ou uploader un fichier</p>
                    <label class="hw-file-btn">
                        <i class="fas fa-paperclip"></i> Choisir un fichier
                        <input name="filesCorrection" type="file" class="inputFileHidden" style="display:none;" />
                    </label>
                </div>
            </div>

            <label class="hw-checkbox-field">
                <input type="checkbox" asp-for="IsHomeworkAdditionnal" />
                <span class="hw-checkbox-label">@Html.DisplayNameFor(model => model.IsHomeworkAdditionnal)</span>
            </label>

            <div class="d-none">
                <select asp-for="TheoryId" asp-items="ViewBag.TheoryId"></select>
            </div>
            <input type="hidden" asp-for="TeacherId" value="@ViewData["TeacherId"]" />
            <input asp-for="ExerciceDate" type="hidden" value="@ViewData["ExerciceDate"]" />
            <input type="hidden" asp-for="ExerciceName" value="Pas de nom" />

            <button type="submit" class="hw-btn-save">
                <i class="fas fa-save"></i> Sauvegarder
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $('.datetimepicker').datetimepicker({
            locale: 'fr',
            icons: { time:"fa fa-clock-o", date:"fa fa-calendar", up:"fa fa-chevron-up", down:"fa fa-chevron-down", previous:'fa fa-chevron-left', next:'fa fa-chevron-right', today:'fa fa-screenshot', clear:'fa fa-trash', close:'fa fa-remove' }
        });
        $('.datetimepicker').on('dp.change', function (e) {
            if (e.oldDate === null) {
                $(this).data('DateTimePicker').date(new Date(e.date._d.setHours(17, 0, 0)));
            }
        });
    </script>
}