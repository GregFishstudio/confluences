@model mvc.Models.Exercice

@{
    ViewData["Title"] = "Exercice";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }
    .hw-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
    .hw-topbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem; border-bottom: 1px solid #f1f3f9; gap: 12px; flex-wrap: wrap; }
    .hw-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 4px; }
    .hw-title { font-family: 'Lora', serif; font-size: 22px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .hw-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #6c757d; text-decoration: none; border: 1px solid #eef0f7; border-radius: 10px; padding: 7px 14px; transition: all 0.15s; }
    .hw-back:hover { background: #f8f9fc; color: #1a1a2e; text-decoration: none; }
    .hw-body { padding: 1.5rem; }
    .hw-section-title { font-size: 11px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: #aaa; margin: 0 0 12px; padding-bottom: 8px; border-bottom: 1px solid #f1f3f9; }
    .hw-section { margin-bottom: 2rem; }
    .hw-correction-banner { background: #EAF3DE; border: 1px solid #C0DD97; border-radius: 12px; padding: 14px 16px; margin-bottom: 1.5rem; font-size: 13px; font-weight: 500; color: #3B6D11; display: flex; align-items: center; gap: 8px; }
    .hw-student-block { background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 12px; padding: 16px; margin-bottom: 1rem; }
    .hw-student-name { font-size: 14px; font-weight: 500; color: #1a1a2e; margin: 0 0 4px; }
    .hw-student-date { font-size: 12px; color: #aaa; margin: 0 0 12px; }
    .hw-media-container { border-radius: 10px; overflow: hidden; margin-bottom: 12px; }
    .hw-textarea { width: 100%; background: #fff; border: 1px solid #eef0f7; border-radius: 10px; padding: 9px 14px; font-size: 13px; color: #1a1a2e; font-family: 'DM Sans', sans-serif; outline: none; resize: vertical; }
    .hw-textarea:focus { border-color: #c0c8e8; }
    .hw-comment-block { background: #FCEBEB; border-left: 3px solid #A32D2D; border-radius: 0 8px 8px 0; padding: 12px 14px; font-size: 13px; color: #A32D2D; font-weight: 500; margin-top: 8px; }
    .hw-btn-sm { display: inline-flex; align-items: center; gap: 5px; border: none; border-radius: 8px; padding: 7px 14px; font-size: 12px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: opacity 0.15s; }
    .hw-btn-success { background: #1a1a2e; color: #fff; }
    .hw-btn-success:hover { opacity: 0.8; }
    .hw-btn-danger { background: transparent; color: #A32D2D; border: 1px solid #F09595; }
    .hw-btn-danger:hover { background: #FCEBEB; }
    .hw-download-btn { display: inline-flex; align-items: center; gap: 6px; background: #1a1a2e; color: #fff; border-radius: 10px; padding: 9px 16px; font-size: 13px; font-weight: 500; text-decoration: none; margin-top: 10px; transition: opacity 0.15s; }
    .hw-download-btn:hover { opacity: 0.8; color: #fff; text-decoration: none; }
    .hw-submit-btn { display: block; width: 100%; background: #1a1a2e; color: #fff; border: none; border-radius: 10px; padding: 10px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; text-align: center; margin-top: 8px; transition: opacity 0.15s; }
    .hw-submit-btn:hover { opacity: 0.8; }
    .hw-render-btn { display: block; width: 100%; background: #f8f9fc; border: 1px dashed #c0c8e8; border-radius: 10px; padding: 14px; font-size: 13px; color: #6c757d; text-align: center; cursor: pointer; transition: all 0.15s; }
    .hw-render-btn:hover { background: #eef0f7; color: #1a1a2e; }
    .hw-teacher-actions { display: flex; gap: 8px; margin-top: 0.5rem; flex-wrap: wrap; }
    .control-wrapper { height: 100%; }
    .e-img-editor-sample { height: 70vh; width: 100%; }
    @@media only screen and (max-width: 700px) { .e-img-editor-sample { height: 65vh; } }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Exercice</p>
        <h1 class="hw-title">Détails de l'exercice</h1>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                @if ((bool)ViewData["IsTeacher"])
                {
                    <a asp-action="Edit" asp-route-id="@Model.ExerciceId" class="hw-back"><i class="fas fa-pen"></i> Modifier</a>
                    <a asp-action="Delete" asp-route-id="@Model.ExerciceId" class="hw-back" style="color:#A32D2D;border-color:#F09595;"><i class="fas fa-trash"></i> Supprimer</a>
                }
                <a href="javascript:history.back()" class="hw-back"><i class="fas fa-arrow-left"></i> Retour</a>
            </div>
        </div>

        <div class="hw-body">

            @if (Model.CorrectionDate <= DateTime.Now)
            {
                <div class="hw-section">
                    <div class="hw-correction-banner">
                        <i class="fas fa-check-circle"></i> Correction disponible
                    </div>
                    @if (Model.CorrectionLink != null)
                    {
                        @if (Model.CorrectionLink.ToLower().EndsWith("pdf"))
                        {
                            <ejs-pdfviewer id="pdfviewer" serviceUrl="@ViewData["URLAPI"]api/PdfViewer" documentPath="@Model.CorrectionLink"></ejs-pdfviewer>
                        }
                        else
                        {
                            <div class="embed-responsive embed-responsive-1by1">
                                @if (!Model.CorrectionLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                                {
                                    <iframe class="embed-responsive-item" src="@ViewData["URLAPI"]@Html.DisplayFor(model => model.CorrectionLink)" allowfullscreen></iframe>
                                }
                                else
                                {
                                    <iframe class="embed-responsive-item" src="@Html.DisplayFor(model => model.CorrectionLink)" allowfullscreen></iframe>
                                }
                            </div>
                        }
                        <a class="hw-download-btn" href="@(Model.CorrectionLink.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.CorrectionLink : ViewData["URLAPI"] + Model.CorrectionLink)">
                            <i class="fas fa-download"></i> Télécharger la correction
                        </a>
                    }
                </div>
            }

            @foreach (var homework in Model.HomeworkV2students)
            {
                <div class="hw-section">
                    <div class="hw-student-block">
                        @if (User.Identity.Name == homework.Student.UserName)
                        {
                            <p class="hw-student-name">Mon exercice</p>
                        }
                        else
                        {
                            <p class="hw-student-name">Exercice de @homework.Student.Firstname</p>
                            <p class="hw-student-date">Rendu le @homework.HomeworkStudentDate.ToString("dd MMMM yyyy à HH:mm")</p>
                        }

                        <div class="hw-media-container">
                            @if (homework.HomeworkFileType?.Contains("audio") ?? false)
                            {
                                <audio controls style="width:100%;">
                                    <source src="@(ViewData["URLAPI"]+homework.HomeworkFile)" type="@homework.HomeworkFileType">
                                </audio>
                            }
                            else if (homework.HomeworkFileType?.Contains("video") ?? false)
                            {
                                <video controls style="width:100%;">
                                    <source src="@(ViewData["URLAPI"]+homework.HomeworkFile)" type="@homework.HomeworkFileType">
                                </video>
                            }
                            else if (homework.HomeworkFileType?.Contains("image") ?? false || string.IsNullOrEmpty(homework.HomeworkFileType))
                            {
                                <div class="control-section e-img-editor-sample">
                                    @if ((bool)ViewData["IsTeacher"])
                                    {
                                        <ejs-imageeditor id="image-editor-@homework.HomeworkV2studentId"
                                             data-id="@homework.HomeworkV2studentId"
                                             data-url="@ViewData["URLAPI"]@homework.HomeworkFile"
                                             data-api-url="@ViewData["URLAPI"]api/UploadFiles/UploadHomeworkStudentLive"></ejs-imageeditor>
                                    }
                                    else
                                    {
                                        <a href="@ViewData["URLAPI"]@homework.HomeworkFile">
                                            <ejs-imageeditor id="image-editor-@homework.HomeworkV2studentId"
                                                 toolbar="Array.Empty<string>()"
                                                 data-id="@homework.HomeworkV2studentId"
                                                 data-url="@ViewData["URLAPI"]@homework.HomeworkFile"
                                                 data-api-url="@ViewData["URLAPI"]api/UploadFiles/UploadHomeworkStudentLive">
                                            </ejs-imageeditor>
                                        </a>
                                    }
                                </div>
                            }
                            else
                            {
                                <a href="@(ViewData["URLAPI"]+homework.HomeworkFile)" download class="hw-download-btn">
                                    <i class="fas fa-download"></i> Télécharger (format inconnu)
                                </a>
                            }
                        </div>

                        @if ((bool)ViewData["IsTeacher"])
                        {
                            @if (homework.HomeworkFileType?.Contains("image") ?? false || string.IsNullOrEmpty(homework.HomeworkFileType))
                            {
                                <button type="button" class="hw-submit-btn" onclick='saveSyncfusionImage("image-editor-@homework.HomeworkV2studentId", "@ViewData["URLAPI"]api/UploadFiles/UploadHomeworkStudentLive", @homework.HomeworkV2studentId)'>
                                    <i class="fas fa-paper-plane"></i> Envoyer la correction
                                </button>
                            }
                            <form asp-controller="HomeworkV2students" asp-action="Edit" style="margin-top:10px;">
                                <input type="hidden" name="id" value="@homework.HomeworkV2studentId" />
                                <input type="hidden" name="ExerciceId" value="@homework.ExerciceId" />
                                <input type="hidden" name="HomeworkV2studentId" value="@homework.HomeworkV2studentId" />
                                <textarea class="hw-textarea" name="HomeworkCommentaryTeacher" rows="3" placeholder="Ajouter un commentaire...">@homework.HomeworkCommentaryTeacher</textarea>
                                <button type="submit" class="hw-submit-btn" style="margin-top:6px;">
                                    <i class="fas fa-comment"></i> Enregistrer le commentaire
                                </button>
                            </form>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(homework.HomeworkCommentaryTeacher))
                            {
                                <div class="hw-comment-block">
                                    <i class="fas fa-comment-alt" style="margin-right:6px;"></i>@homework.HomeworkCommentaryTeacher
                                </div>
                            }
                        }

                        <form asp-controller="HomeworkV2students" asp-action="Delete" style="margin-top:8px;">
                            <input type="hidden" name="id" value="@homework.HomeworkV2studentId" />
                            <button type="submit" class="hw-btn-sm hw-btn-danger">
                                <i class="fas fa-trash"></i> Supprimer ce rendu
                            </button>
                        </form>
                    </div>
                </div>
            }

            @if (Model.HomeworkV2students.Count > 0)
            {
                <div style="margin-top:1rem; border-top:1px solid #f1f3f9; padding-top:1.5rem;"></div>
            }

            <div class="hw-section">
                @if (Model.AudioLink != null)
                {
                    <p class="hw-section-title">Audio 1</p>
                    <audio controls style="width:100%; margin-bottom:1rem;">
                        <source src="@(Model.AudioLink.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.AudioLink : ViewData["URLAPI"] + Model.AudioLink)" type="audio/mp3">
                    </audio>
                }
                @if (Model.AudioLinkSecond != null)
                {
                    <p class="hw-section-title">Audio 2</p>
                    <audio controls style="width:100%; margin-bottom:1rem;">
                        <source src="@(Model.AudioLinkSecond.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.AudioLinkSecond : ViewData["URLAPI"] + Model.AudioLinkSecond)" type="audio/mp3">
                    </audio>
                }
                @if (Model.AudioLinkThird != null)
                {
                    <p class="hw-section-title">Audio 3</p>
                    <audio controls style="width:100%; margin-bottom:1rem;">
                        <source src="@(Model.AudioLinkThird.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.AudioLinkThird : ViewData["URLAPI"] + Model.AudioLinkThird)" type="audio/mp3">
                    </audio>
                }

                @if (Model.VideoLink != null)
                {
                    <p class="hw-section-title">Vidéo</p>
                    <div class="embed-responsive embed-responsive-16by9" style="margin-bottom:1rem;">
                        @if (!Model.VideoLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                        {
                            <iframe class="embed-responsive-item" src="@ViewData["URLAPI"]@Html.DisplayFor(model => model.VideoLink)" allowfullscreen></iframe>
                        }
                        else
                        {
                            <iframe class="embed-responsive-item" src="@Html.DisplayFor(model => model.VideoLink)" allowfullscreen></iframe>
                        }
                    </div>
                }

                <p class="hw-section-title">Exercice</p>
                @if (Model.ExerciceLink != null)
                {
                    @if (Model.ExerciceLink.ToLower().EndsWith("pdf"))
                    {
                        <ejs-pdfviewer id="pdfviewer2" serviceUrl="@ViewData["URLAPI"]api/PdfViewer" documentPath="@Model.ExerciceLink"></ejs-pdfviewer>
                    }
                    else
                    {
                        <div class="embed-responsive embed-responsive-1by1">
                            @if (!Model.ExerciceLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                            {
                                <iframe class="embed-responsive-item" src="@ViewData["URLAPI"]@Html.DisplayFor(model => model.ExerciceLink)" allowfullscreen></iframe>
                            }
                            else
                            {
                                <iframe class="embed-responsive-item" src="@Html.DisplayFor(model => model.ExerciceLink)" allowfullscreen></iframe>
                            }
                        </div>
                    }
                    <a class="hw-download-btn" href="@(Model.ExerciceLink.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.ExerciceLink : ViewData["URLAPI"] + Model.ExerciceLink)">
                        <i class="fas fa-download"></i> Télécharger l'exercice
                    </a>
                }
            </div>

            @if ((bool)ViewData["IsStudent"])
            {
                <div class="hw-section">
                    <p class="hw-section-title">Rendre mon devoir</p>
                    <form id="formDevoirsEleves" asp-controller="HomeworkV2students" asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="hw-validation"></div>
                        <input type="hidden" name="id" value="@Model.ExerciceId" />
                        @if (Model.ExerciceLink != null && !Model.ExerciceLink.Contains("forms"))
                        {
                            <label class="hw-render-btn">
                                <i class="fas fa-upload"></i> Cliquer pour uploader mon devoir (images)
                                <input id="devoirsEleves" name="files" type="file" accept="image/*" multiple style="display:none;" />
                            </label>
                        }
                        else
                        {
                            <label class="hw-render-btn">
                                <i class="fas fa-upload"></i> Cliquer pour uploader mon devoir
                                <input id="devoirsEleves" name="files" type="file" multiple style="display:none;" />
                            </label>
                        }
                    </form>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
<script>
    if (document.getElementById('devoirsEleves') !== null) {
        document.getElementById("devoirsEleves").onchange = function () {
            if (confirm('Êtes-vous sûr-e de vouloir envoyer votre devoir ?')) {
                document.getElementById("formDevoirsEleves").submit();
            } else {
                document.getElementById("devoirsEleves").value = "";
            }
        };
    }
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll("[id^='image-editor-']").forEach(function (editor) {
            openSyncfusionImageEditor(editor.id, editor.getAttribute("data-url"), editor.getAttribute("data-api-url"), editor.getAttribute("data-id"));
        });
    });
</script>
}