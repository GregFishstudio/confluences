@model mvc.Models.Theory

@{
    ViewData["Title"] = "Ajouter un cours";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }
    .hw-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
    .hw-topbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem; border-bottom: 1px solid #f1f3f9; gap: 12px; flex-wrap: wrap; }
    .hw-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 4px; }
    .hw-title { font-family: 'Lora', serif; font-size: 22px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .hw-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #6c757d; text-decoration: none; border: 1px solid #eef0f7; border-radius: 10px; padding: 7px 14px; transition: all 0.15s; }
    .hw-back:hover { background: #f8f9fc; color: #1a1a2e; text-decoration: none; }
    .hw-form-body { padding: 1.5rem; }
    .hw-field { margin-bottom: 1.25rem; }
    .hw-label { display: block; font-size: 12px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: #aaa; margin-bottom: 6px; }
    .hw-input { width: 100%; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; padding: 9px 14px; font-size: 13px; color: #1a1a2e; font-family: 'DM Sans', sans-serif; outline: none; transition: border-color 0.15s, background 0.15s; }
    .hw-input:focus { border-color: #c0c8e8; background: #fff; box-shadow: 0 0 0 3px rgba(78,115,223,0.08); }
    .hw-validation { font-size: 12px; color: #A32D2D; margin-top: 4px; }
    .hw-section { margin-bottom: 1.5rem; }
    .hw-section-title { font-size: 11px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: #aaa; margin: 0 0 10px; }
    .hw-media-block { background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 12px; padding: 14px 16px; }
    .hw-or { font-size: 11px; color: #aaa; text-transform: uppercase; letter-spacing: 0.06em; margin: 8px 0; }
    .hw-file-btn { display: inline-flex; align-items: center; gap: 6px; background: #fff; border: 1px solid #eef0f7; border-radius: 8px; padding: 7px 14px; font-size: 13px; color: #6c757d; cursor: pointer; transition: all 0.15s; }
    .hw-file-btn:hover { background: #eef0f7; color: #1a1a2e; }
    .hw-btn-save { display: inline-flex; align-items: center; gap: 6px; background: #1a1a2e; color: #fff; border: none; border-radius: 10px; padding: 9px 20px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: opacity 0.15s; }
    .hw-btn-save:hover { opacity: 0.8; }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card" style="max-width:660px;">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Cours</p>
                <h1 class="hw-title">Ajouter un cours</h1>
            </div>
            <a href="javascript:history.back()" class="hw-back">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>

        <form enctype="multipart/form-data" asp-action="Create" class="hw-form-body">
            <div asp-validation-summary="ModelOnly" class="hw-validation" style="margin-bottom:1rem;"></div>

            <div class="hw-field">
                <label asp-for="TheoryName" class="hw-label"></label>
                <input asp-for="TheoryName" class="hw-input" />
                <span asp-validation-for="TheoryName" class="hw-validation"></span>
            </div>

            <div class="hw-section">
                <p class="hw-section-title">Vidéo</p>
                <div class="hw-media-block">
                    <div class="hw-field">
                        <label asp-for="VideoLink" class="hw-label"></label>
                        <input asp-for="VideoLink" class="hw-input" placeholder="https://..." />
                        <span asp-validation-for="VideoLink" class="hw-validation"></span>
                    </div>
                    <p class="hw-or">ou uploader un fichier</p>
                    <label class="hw-file-btn">
                        <i class="fas fa-paperclip"></i> Choisir une vidéo
                        <input name="fileVideo" type="file" multiple style="display:none;" />
                    </label>
                </div>
            </div>

            <div class="hw-section">
                <p class="hw-section-title">Audio 1</p>
                <div class="hw-media-block">
                    <div class="hw-field">
                        <label asp-for="AudioLink" class="hw-label"></label>
                        <input asp-for="AudioLink" class="hw-input" placeholder="https://..." />
                        <span asp-validation-for="AudioLink" class="hw-validation"></span>
                    </div>
                    <p class="hw-or">ou uploader un fichier</p>
                    <label class="hw-file-btn">
                        <i class="fas fa-paperclip"></i> Choisir un mp3
                        <input name="fileAudio" type="file" multiple style="display:none;" />
                    </label>
                </div>
            </div>

            <div class="hw-section">
                <p class="hw-section-title">Audio 2</p>
                <div class="hw-media-block">
                    <div class="hw-field">
                        <label asp-for="AudioLinkSecond" class="hw-label"></label>
                        <input asp-for="AudioLinkSecond" class="hw-input" placeholder="https://..." />
                        <span asp-validation-for="AudioLinkSecond" class="hw-validation"></span>
                    </div>
                    <p class="hw-or">ou uploader un fichier</p>
                    <label class="hw-file-btn">
                        <i class="fas fa-paperclip"></i> Choisir un mp3
                        <input name="fileAudioSecond" type="file" multiple style="display:none;" />
                    </label>
                </div>
            </div>

            <div class="hw-section">
                <p class="hw-section-title">Audio 3</p>
                <div class="hw-media-block">
                    <div class="hw-field">
                        <label asp-for="AudioLinkThird" class="hw-label"></label>
                        <input asp-for="AudioLinkThird" class="hw-input" placeholder="https://..." />
                        <span asp-validation-for="AudioLinkThird" class="hw-validation"></span>
                    </div>
                    <p class="hw-or">ou uploader un fichier</p>
                    <label class="hw-file-btn">
                        <i class="fas fa-paperclip"></i> Choisir un mp3
                        <input name="fileAudioThird" type="file" multiple style="display:none;" />
                    </label>
                </div>
            </div>

            <div class="hw-section">
                <p class="hw-section-title">Fichier cours</p>
                <div class="hw-media-block">
                    <div class="hw-field">
                        <label asp-for="TheoryLink" class="hw-label"></label>
                        <input asp-for="TheoryLink" class="hw-input" placeholder="https://..." />
                        <span asp-validation-for="TheoryLink" class="hw-validation"></span>
                    </div>
                    <p class="hw-or">ou uploader un fichier</p>
                    <label class="hw-file-btn">
                        <i class="fas fa-paperclip"></i> Choisir un fichier
                        <input name="files" type="file" style="display:none;" />
                    </label>
                </div>
            </div>

            <div class="d-none">
                <select asp-for="HomeworkV2id" asp-items="ViewBag.HomeworkV2id"></select>
            </div>
            <input type="hidden" asp-for="TeacherId" value="@ViewData["TeacherId"]" />
            <input asp-for="TheoryDate" type="hidden" value="@ViewData["TheoryDate"]" />

            <button type="submit" class="hw-btn-save">
                <i class="fas fa-save"></i> Sauvegarder
            </button>
        </form>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}