@model IEnumerable<mvc.Models.HomeworkV2s>

@{
    ViewData["Title"] = "Ressources";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }
    .hw-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
    .hw-topbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 1.5rem 1rem; border-bottom: 1px solid #f1f3f9; gap: 12px; flex-wrap: wrap; }
    .hw-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 4px; }
    .hw-title { font-family: 'Lora', serif; font-size: 22px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .hw-subtitle { font-size: 13px; color: #aaa; margin: 4px 0 0; }

    /* DataTables overrides */
    .hw-card .dataTables_wrapper { padding: 1rem 1.5rem 1.5rem; }
    .hw-card .dataTables_filter input { background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; padding: 6px 12px; font-size: 13px; font-family: 'DM Sans', sans-serif; color: #1a1a2e; outline: none; margin-left: 8px; }
    .hw-card .dataTables_filter input:focus { border-color: #c0c8e8; }
    .hw-card .dataTables_length select { background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 8px; padding: 4px 8px; font-size: 13px; font-family: 'DM Sans', sans-serif; color: #1a1a2e; }
    .hw-table { width: 100%; border-collapse: collapse; }
    .hw-table thead th { font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #aaa; padding: 10px 1rem; border-bottom: 1px solid #f1f3f9; text-align: left; background: #f8f9fc; }
    .hw-table tbody tr { border-bottom: 1px solid #f1f3f9; transition: background 0.1s; }
    .hw-table tbody tr:hover { background: #fafbfe; }
    .hw-table tbody td { padding: 12px 1rem; font-size: 13px; color: #1a1a2e; vertical-align: middle; }
    .badge-h { background: #e0e7ff; color: #4338ca; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; text-transform: uppercase; }
    .badge-t { background: #fef3c7; color: #92400e; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; text-transform: uppercase; }
    .badge-e { background: #dcfce7; color: #166534; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; text-transform: uppercase; }
    .action-link { font-weight: 600; text-decoration: none; transition: opacity 0.15s; margin-right: 8px; font-size: 12px; }
    .view-link { color: #4e73df; }
    .dup-link { color: #1cc88a; }
    .action-link:hover { opacity: 0.7; }
    .hw-card .dataTables_info { font-size: 12px; color: #aaa; }
    .hw-card .paginate_button { border-radius: 8px !important; font-size: 12px !important; }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Pédagogie</p>
                <h1 class="hw-title">Ressources</h1>
                <p class="hw-subtitle">Accès centralisé à toutes les ressources pédagogiques (Archives et Serveur)</p>
            </div>
        </div>

        <div class="table-responsive">
            <table id="datatables" class="hw-table" style="width:100%">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Session</th>
                        <th>Date</th>
                        <th>Titre de la ressource</th>
                        <th>Type</th>
                        <th>Formateur</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @* Rempli par AJAX *@
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#datatables').DataTable({
                "proccessing": true,
                "serverSide": true,
                "ajax": {
                    url: '@ViewData["URLAPI"]api/RessourcePaginated',
                    type: 'POST'
                },
                "pagingType": "simple_numbers",
                "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Tout"]],
                "responsive": true,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.20/i18n/French.json"
                },
                "order": [[2, "desc"]],
                "columns": [
                    { "data": "id" },
                    { "data": "sessionNumber" },
                    { "data": "date" },
                    { "data": "name" },
                    { "data": "homeworkTypeName" },
                    { "data": "teacher" },
                    { "data": "ressourceType" }
                ],
                "columnDefs": [
                    { "targets": [0], "visible": false },
                    {
                        "targets": 2,
                        "render": function (data) {
                            return '<span class="text-muted font-weight-bold"><i class="far fa-calendar-alt mr-1"></i>' + moment(data).format('YYYY-MM-DD') + '</span>';
                        }
                    },
                    {
                        "targets": 3,
                        "render": function (data, type, row) {
                            var prefix = "/Homeworkv2s";
                            if (row['ressourceType'] == 'T') prefix = "/Theories";
                            else if (row['ressourceType'] == 'E') prefix = "/Exercices";
                            else if (row['ressourceType'] == 'EA') prefix = "/ExercicesAlones";

                            return '<a class="action-link view-link" href="' + prefix + '/Details/' + row['id'] + '">' + data + '</a>';
                        }
                    },
                    {
                        "targets": 4,
                        "render": function (data) {
                            return '<span class="badge badge-light px-3 py-2 rounded-pill">' + data + '</span>';
                        }
                    },
                    {
                        "targets": 6,
                        "className": "text-right",
                        "render": function (data, type, row) {
                            var prefix = "/Homeworkv2s";
                            var canDuplicate = true;

                            if (row['ressourceType'] == 'T') prefix = "/Theories";
                            else if (row['ressourceType'] == 'E') prefix = "/Exercices";
                            else if (row['ressourceType'] == 'EA') prefix = "/ExercicesAlones";
                            else { canDuplicate = false; }

                            var html = '<a class="action-link view-link" href="' + prefix + '/Details/' + row['id'] + '"><i class="fas fa-eye"></i> Aperçu</a>';
                            if(canDuplicate) {
                                html += '<a class="action-link dup-link ml-2" href="' + prefix + '/Duppliquer/' + row['id'] + '"><i class="fas fa-copy"></i> Dupliquer</a>';
                            }
                            return html;
                        }
                    }
                ],
                "dom": "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                       "<'row'<'col-sm-12'tr>>" +
                       "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
            });
        });
    </script>
}
