@model IEnumerable<mvc.Models.HomeworkV2s>

@{
    ViewData["Title"] = "Ressources";
}

<style>
    :root {
        --bg-gradient: linear-gradient(135deg, #f0f4ff 0%, #f1fff5 50%, #ffffff 100%);
        --primary-modern: #4e73df;
        --border-soft: rgba(0, 0, 0, 0.06);
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    }

    body, .bgImage {
        background: var(--bg-gradient) !important;
        background-attachment: fixed !important;
        font-family: 'Inter', 'Segoe UI', sans-serif;
        color: #2e3d49;
    }

    /* Header Glassmorphism */
    .header-glass {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
    }

    /* Admin Card Container */
    .admin-card {
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid var(--border-soft);
        box-shadow: var(--card-shadow);
        overflow: hidden;
        padding: 1.5rem;
    }

    /* DataTables Overrides */
    .custom-table thead th {
        background-color: #f8f9fc;
        color: #858796;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        padding: 1.2rem 1.5rem;
        border: none;
    }

    .custom-table tbody td {
        padding: 1.2rem 1.5rem;
        vertical-align: middle;
        border-top: 1px solid #f1f3f9;
        font-size: 0.9rem;
    }

    /* Ressource Type Badges */
    .res-badge {
        font-size: 0.7rem;
        font-weight: 800;
        padding: 0.3rem 0.6rem;
        border-radius: 8px;
        text-transform: uppercase;
    }
    .badge-h { background: #e0e7ff; color: #4338ca; } /* Devoir */
    .badge-t { background: #fef3c7; color: #92400e; } /* Théorie */
    .badge-e { background: #dcfce7; color: #166534; } /* Exercice */

    /* Action Links Styling */
    .action-link {
        font-weight: 600;
        text-decoration: none !important;
        transition: 0.2s;
        margin-right: 10px;
    }
    .view-link { color: var(--primary-modern); }
    .dup-link { color: #1cc88a; }
    .action-link:hover { opacity: 0.7; transform: translateY(-1px); }

    /* Custom Search Input */
    .dataTables_filter input {
        border-radius: 10px;
        border: 1px solid #d1d3e2;
        padding: 5px 15px;
        margin-left: 10px;
    }
</style>

<div class="container-fluid py-4 px-md-5">

    <div class="header-glass mt-3">
        <h1 class="h3 font-weight-bold mb-1">🗂️ @ViewData["Title"]</h1>
        <p class="text-muted small mb-0">Accès centralisé à toutes les ressources pédagogiques (Archives et Serveur)</p>
    </div>

    <div class="admin-card">
        <div class="table-responsive">
            <table id="datatables" class="table custom-table mb-0" style="width:100%">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Session</th>
                        <th>Date</th>
                        <th>Titre de la ressource</th>
                        <th>Type</th>
                        <th>Formateur</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @* Rempli par AJAX *@
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#datatables').DataTable({
                "proccessing": true,
                "serverSide": true,
                "ajax": {
                    url: '@ViewData["URLAPI"]api/RessourcePaginated',
                    type: 'POST'
                },
                "pagingType": "simple_numbers",
                "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Tout"]],
                "responsive": true,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.20/i18n/French.json"
                },
                "order": [[2, "desc"]],
                "columns": [
                    { "data": "id" },
                    { "data": "sessionNumber" },
                    { "data": "date" },
                    { "data": "name" },
                    { "data": "homeworkTypeName" },
                    { "data": "teacher" },
                    { "data": "ressourceType" }
                ],
                "columnDefs": [
                    { "targets": [0], "visible": false },
                    {
                        "targets": 2, 
                        "render": function (data) {
                            return '<span class="text-muted font-weight-bold"><i class="far fa-calendar-alt mr-1"></i>' + moment(data).format('YYYY-MM-DD') + '</span>';
                        }
                    },
                    {
                        "targets": 3, 
                        "render": function (data, type, row) {
                            var prefix = "/Homeworkv2s";
                            if (row['ressourceType'] == 'T') prefix = "/Theories";
                            else if (row['ressourceType'] == 'E') prefix = "/Exercices";
                            else if (row['ressourceType'] == 'EA') prefix = "/ExercicesAlones";
                            
                            return '<a class="action-link view-link" href="' + prefix + '/Details/' + row['id'] + '">' + data + '</a>';
                        }
                    },
                    {
                        "targets": 4,
                        "render": function (data) {
                            return '<span class="badge badge-light px-3 py-2 rounded-pill">' + data + '</span>';
                        }
                    },
                    {
                        "targets": 6, 
                        "className": "text-right",
                        "render": function (data, type, row) {
                            var prefix = "/Homeworkv2s";
                            var canDuplicate = true;
                            
                            if (row['ressourceType'] == 'T') prefix = "/Theories";
                            else if (row['ressourceType'] == 'E') prefix = "/Exercices";
                            else if (row['ressourceType'] == 'EA') prefix = "/ExercicesAlones";
                            else { canDuplicate = false; }

                            var html = '<a class="action-link view-link" href="' + prefix + '/Details/' + row['id'] + '"><i class="fas fa-eye"></i> Aperçu</a>';
                            if(canDuplicate) {
                                html += '<a class="action-link dup-link ml-2" href="' + prefix + '/Duppliquer/' + row['id'] + '"><i class="fas fa-copy"></i> Dupliquer</a>';
                            }
                            return html;
                        }
                    }
                ],
                "dom": "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                       "<'row'<'col-sm-12'tr>>" +
                       "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
            });
        });
    </script>
}