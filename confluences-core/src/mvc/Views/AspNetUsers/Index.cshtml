@model IEnumerable<mvc.Models.AspNetUser>

@{
    ViewData["Title"] = "Gestion des Utilisateurs";
}

<partial name="_Notification.cshtml" />

<style>
     :root {
        --bg-gradient: linear-gradient(135deg, #f0f4ff 0%, #f1fff5 50%, #ffffff 100%);
        --primary-modern: #4e73df;
        --border-soft: rgba(0, 0, 0, 0.05);
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    }

    body, .bgImage {
        background: var(--bg-gradient) !important;
        background-attachment: fixed !important;
        font-family: 'Inter', sans-serif;
        color: #2e3d49;
    }

    .dashboard-container {
       width: 100%;
    max-width: 100%; /* Force le dépassement des limites du container standard */
    margin: 0;
    }

    /* Card Styling */
    .admin-card {
        background: #fff;
        border: none;
        border-radius: 0.75rem;
        box-shadow: var(--card-shadow);
        overflow: hidden;
    }

    .card-header-actions {
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e3e6f0;
        background-color: #fff;
    }

    /* Table Styling */
    .table-responsive {
        padding: 0;
    }

    .custom-table {
        width: 100%;
        margin-bottom: 0;
        color: var(--text-dark);
        border-collapse: separate;
        border-spacing: 0;
    }

    .custom-table thead th {
        background-color: #f8f9fc;
        color: #858796;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e3e6f0;
        border-top: none;
    }

    .custom-table tbody td {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        border-top: 1px solid #e3e6f0;
        font-size: 0.9rem;
    }

    .custom-table tbody tr:hover {
        background-color: #fafbfc;
    }

    /* User Profile in Table */
    .user-profile-compact {
        display: flex;
        align-items: center;
    }

    .user-avatar-circle {
        width: 40px;
        height: 40px;
        background-color: var(--primary-color);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-right: 1rem;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    .user-info h6 {
        margin: 0;
        font-weight: 600;
        color: #4e73df;
    }

    .user-info small {
        color: #858796;
    }

    /* Badges */
    .badge-soft {
        padding: 0.35rem 0.6rem;
        border-radius: 0.35rem;
        font-size: 0.75rem;
        font-weight: 700;
        background-color: rgba(78, 115, 223, 0.1);
        color: var(--primary-color);
    }

    /* Action Buttons */
    .btn-action {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.35rem;
        color: var(--secondary-color);
        transition: all 0.2s;
        background: transparent;
        border: 1px solid transparent;
    }

    .btn-action:hover {
        background-color: #eaecf4;
        color: var(--primary-color);
    }
    
    .btn-action.delete:hover {
        background-color: #fce8e6;
        color: var(--danger-color);
    }

    /* DataTables Overrides */
    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid #d1d3e2;
        border-radius: 0.35rem;
        padding: 0.375rem 0.75rem;
        outline: none;
        transition: border-color 0.15s;
    }
    .dataTables_wrapper .dataTables_filter input:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
    }
    .dataTables_wrapper .dataTables_length select {
        border: 1px solid #d1d3e2;
        border-radius: 0.35rem;
        padding: 0.2rem 1.5rem 0.2rem 0.5rem;
    }
    .page-item.active .page-link {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }
</style>

<div class="container-fluid dashboard-container px-4">

    <div class="admin-card">
        <div class="card-header-actions">
           <div class="mb-4">
    <h2 class="font-weight-bold text-dark mb-1">Gestion des utilisateurs</h2>
    <p class="text-muted mb-0">
        Gérez les accès et les comptes étudiants / professeurs
    </p>
</div>

            <a class="btn btn-success btn-icon-split shadow-sm" href="@ViewData["URLIdentityServer4"]Account/SignUp">
                <span class="icon text-white-50">
                    <i class="fas fa-user-plus"></i>
                </span>
                <span class="text">Nouvel utilisateur</span>
            </a>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="datatables" class="custom-table" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Utilisateur</th>
                            <th>Identifiant</th>
                            <th>Niveau / Classe</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            // Logique pour l'avatar (initiales)
                            string initials = "U";
                            if (!string.IsNullOrEmpty(item.Firstname)) { initials = item.Firstname.Substring(0, 1); }
                            if (!string.IsNullOrEmpty(item.LastName)) { initials += item.LastName.Substring(0, 1); }
                            
                            // Logique pour la classe
                            var lastSession = item.SessionStudents?.LastOrDefault();
                            string className = lastSession?.Session?.SchoolClassRoom?.SchoolClassRoomName;

                            <tr>
                                <td>
                                    <div class="user-profile-compact">
                                        <div class="user-avatar-circle">
                                            @initials
                                        </div>
                                        <div class="user-info">
                                            <a asp-action="Details" asp-route-id="@item.Id" style="text-decoration:none;">
                                                <h6>@item.Firstname @item.LastName</h6>
                                            </a>
                                            <small>@item.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-dark font-weight-bold">@item.UserName</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(className))
                                    {
                                        <span class="badge-soft">@className</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small font-italic">Non assigné</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action mr-1" title="Modifier">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#datatables').DataTable({
                "pagingType": "simple_numbers",
                "lengthMenu": [
                    [10, 25, 50, -1],
                    [10, 25, 50, "Tous"]
                ],
                responsive: true,
                language: {
                    "url": "//cdn.datatables.net/plug-ins/1.10.20/i18n/French.json",
                    searchPlaceholder: "Rechercher un utilisateur..."
                },
                "order": [[0, "asc"]], // Tri par défaut sur la colonne Nom
                "columnDefs": [
                    { "orderable": false, "targets": 3 } // Désactive le tri sur la colonne Actions
                ],
                // Nettoyage de l'interface DataTables (DOM positioning)
                "dom": "<'row px-4 pt-4'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                       "<'row'<'col-sm-12'tr>>" +
                       "<'row px-4 pb-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
}