@model mvc.Models.AspNetUser

@{
    ViewData["Title"] = "Modifier un utilisateur";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }
    .hw-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
    .hw-topbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 1.5rem 1rem; border-bottom: 1px solid #f1f3f9; gap: 12px; flex-wrap: wrap; }
    .hw-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 4px; }
    .hw-title { font-family: 'Lora', serif; font-size: 22px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .hw-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #6c757d; text-decoration: none; border: 1px solid #eef0f7; border-radius: 10px; padding: 7px 14px; transition: all 0.15s; }
    .hw-back:hover { background: #f8f9fc; color: #1a1a2e; text-decoration: none; }
    .hw-form-body { padding: 2rem 1.5rem; }
    .hw-section { font-size: 11px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: #aaa; margin: 0 0 12px; padding-bottom: 8px; border-bottom: 1px solid #f1f3f9; }
    .hw-field { margin-bottom: 1.25rem; }
    .hw-label { display: block; font-size: 12px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: #aaa; margin-bottom: 6px; }
    .hw-input, .hw-select { width: 100%; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; padding: 9px 14px; font-size: 13px; color: #1a1a2e; font-family: 'DM Sans', sans-serif; outline: none; transition: border-color 0.15s, background 0.15s; appearance: none; -webkit-appearance: none; }
    .hw-input:focus, .hw-select:focus { border-color: #c0c8e8; background: #fff; box-shadow: 0 0 0 3px rgba(78,115,223,0.08); }
    .hw-input:disabled { opacity: 0.5; cursor: not-allowed; }
    .hw-select-wrap { position: relative; }
    .hw-select-wrap::after { content: '\f078'; font-family: 'Font Awesome 5 Free'; font-weight: 900; position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 11px; color: #aaa; pointer-events: none; }
    .hw-file-field { display: flex; align-items: center; gap: 10px; }
    .hw-file-label { display: inline-flex; align-items: center; gap: 6px; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; padding: 9px 14px; font-size: 13px; color: #6c757d; cursor: pointer; transition: all 0.15s; }
    .hw-file-label:hover { background: #eef0f7; color: #1a1a2e; }
    .hw-file-name { font-size: 12px; color: #aaa; }
    .hw-checkbox-field { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; cursor: pointer; margin-bottom: 1.25rem; }
    .hw-checkbox-field input[type="checkbox"] { width: 16px; height: 16px; accent-color: #1a1a2e; cursor: pointer; }
    .hw-checkbox-label { font-size: 13px; color: #1a1a2e; cursor: pointer; margin: 0; }
    .hw-validation { font-size: 12px; color: #A32D2D; margin-top: 4px; }
    .hw-btn-save { display: inline-flex; align-items: center; gap: 6px; background: #1a1a2e; color: #fff; border: none; border-radius: 10px; padding: 9px 20px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: opacity 0.15s; }
    .hw-btn-save:hover { opacity: 0.8; }
    .hw-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.5rem; }
    @@media (max-width: 600px) { .hw-grid-2 { grid-template-columns: 1fr; } }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card" style="max-width:680px;">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Utilisateurs</p>
                <h1 class="hw-title">Modifier un utilisateur</h1>
            </div>
            <a asp-action="Index" class="hw-back">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>

        <form asp-action="Edit" enctype="multipart/form-data" class="hw-form-body">
            <div asp-validation-summary="ModelOnly" class="hw-validation" style="margin-bottom:1rem;"></div>
            <input type="hidden" asp-for="Id" />

            <p class="hw-section">Photo de profil</p>
            <div class="hw-field">
                <label class="hw-file-label" for="Pictures">
                    <i class="fas fa-camera"></i> Choisir une image
                </label>
                <input asp-for="Pictures" type="file" id="Pictures" style="display:none;" onchange="document.getElementById('file-name').textContent = this.files[0]?.name ?? ''" />
                <span class="hw-file-name" id="file-name"></span>
            </div>

            <p class="hw-section" style="margin-top:1.5rem;">Informations personnelles</p>
            <div class="hw-grid-2">
                <div class="hw-field">
                    <label asp-for="Firstname" class="hw-label"></label>
                    <input asp-for="Firstname" class="hw-input" />
                    <span asp-validation-for="Firstname" class="hw-validation"></span>
                </div>
                <div class="hw-field">
                    <label asp-for="LastName" class="hw-label"></label>
                    <input asp-for="LastName" class="hw-input" />
                    <span asp-validation-for="LastName" class="hw-validation"></span>
                </div>
            </div>

            <div class="hw-grid-2">
                <div class="hw-field">
                    <label asp-for="GenderId" class="hw-label"></label>
                    <div class="hw-select-wrap">
                        <select asp-for="GenderId" class="hw-select" asp-items="ViewBag.GenderId"></select>
                    </div>
                    <span asp-validation-for="GenderId" class="hw-validation"></span>
                </div>
                <div class="hw-field">
                    <label asp-for="Birthday" class="hw-label"></label>
                    <input asp-for="Birthday" type="text" class="hw-input datetimepicker" value="@Model.Birthday.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="Birthday" class="hw-validation"></span>
                </div>
            </div>

            <div class="hw-grid-2">
                <div class="hw-field">
                    <label asp-for="Nationality" class="hw-label"></label>
                    <input asp-for="Nationality" class="hw-input" />
                    <span asp-validation-for="Nationality" class="hw-validation"></span>
                </div>
                <div class="hw-field">
                    <label asp-for="Language" class="hw-label"></label>
                    <input asp-for="Language" class="hw-input" />
                    <span asp-validation-for="Language" class="hw-validation"></span>
                </div>
            </div>

            <p class="hw-section" style="margin-top:1.5rem;">Contact & compte</p>
            <div class="hw-grid-2">
                <div class="hw-field">
                    <label asp-for="Email" class="hw-label"></label>
                    <input asp-for="Email" class="hw-input" />
                    <span asp-validation-for="Email" class="hw-validation"></span>
                </div>
                <div class="hw-field">
                    <label asp-for="PhoneNumber" class="hw-label"></label>
                    <input asp-for="PhoneNumber" class="hw-input" />
                    <span asp-validation-for="PhoneNumber" class="hw-validation"></span>
                </div>
            </div>

            <div class="hw-field">
                <label asp-for="UserName" class="hw-label"></label>
                <input asp-for="UserName" class="hw-input" disabled />
            </div>

            <p class="hw-section" style="margin-top:1.5rem;">Préférences</p>
            <label class="hw-checkbox-field">
                <input type="checkbox" asp-for="WantsMoreHomeworks" />
                <span class="hw-checkbox-label">@Html.DisplayNameFor(model => model.WantsMoreHomeworks)</span>
            </label>

            <button type="submit" class="hw-btn-save">
                <i class="fas fa-save"></i> Sauvegarder
            </button>
        </form>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $('.datetimepicker').datetimepicker({
            locale: 'fr', format: 'yyyy-MM-DD',
            icons: { time:"fa fa-clock-o", date:"fa fa-calendar", up:"fa fa-chevron-up", down:"fa fa-chevron-down", previous:'fa fa-chevron-left', next:'fa fa-chevron-right', today:'fa fa-screenshot', clear:'fa fa-trash', close:'fa fa-remove' }
        });
    </script>
}
