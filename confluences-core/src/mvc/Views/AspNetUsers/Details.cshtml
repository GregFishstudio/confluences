@model mvc.Models.AspNetUser

@{
    ViewData["Title"] = "Utilisateur-trice";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }
    .hw-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }

    .user-header {
        display: flex; align-items: center; gap: 24px;
        padding: 1.5rem; border-bottom: 1px solid #f1f3f9;
        flex-wrap: wrap;
    }
    .user-avatar {
        width: 80px; height: 80px; border-radius: 50%;
        object-fit: cover; border: 3px solid #f1f3f9; flex-shrink: 0;
    }
    .user-avatar-placeholder {
        width: 80px; height: 80px; border-radius: 50%;
        background: #f0f2f5; border: 3px solid #f1f3f9;
        display: flex; align-items: center; justify-content: center;
        font-size: 28px; font-weight: 500; color: #aaa; flex-shrink: 0;
    }
    .user-header-info { flex: 1; }
    .user-header-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 4px; }
    .user-header-name { font-family: 'Lora', serif; font-size: 22px; font-weight: 600; color: #1a1a2e; margin: 0 0 6px; }
    .user-header-class { display: inline-flex; align-items: center; gap: 6px; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 8px; padding: 3px 10px; font-size: 12px; color: #1a1a2e; font-weight: 500; }
    .user-header-actions { display: flex; gap: 8px; flex-wrap: wrap; }

    .hw-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #6c757d; text-decoration: none; border: 1px solid #eef0f7; border-radius: 10px; padding: 7px 14px; transition: all 0.15s; }
    .hw-back:hover { background: #f8f9fc; color: #1a1a2e; text-decoration: none; }
    .hw-btn-edit { display: inline-flex; align-items: center; gap: 6px; background: #1a1a2e; color: #fff; border-radius: 10px; padding: 8px 16px; font-size: 13px; font-weight: 500; text-decoration: none; transition: opacity 0.15s; }
    .hw-btn-edit:hover { opacity: 0.8; color: #fff; text-decoration: none; }

    .user-body { padding: 1.5rem; }
    .user-section-title { font-size: 11px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: #aaa; margin: 0 0 12px; padding-bottom: 8px; border-bottom: 1px solid #f1f3f9; }
    .user-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-bottom: 2rem; }
    .user-field { background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 12px; padding: 12px 16px; }
    .user-field-label { font-size: 11px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: #aaa; margin-bottom: 4px; }
    .user-field-value { font-size: 13px; color: #1a1a2e; font-weight: 400; word-break: break-all; }
    .user-field-value a { color: #0C447C; text-decoration: none; }
    .user-field-value a:hover { text-decoration: underline; }

    .user-bool-yes { display: inline-flex; align-items: center; gap: 4px; background: #EAF3DE; color: #3B6D11; border-radius: 20px; padding: 2px 10px; font-size: 11px; font-weight: 500; }
    .user-bool-no  { display: inline-flex; align-items: center; gap: 4px; background: #f8f9fc; color: #aaa; border-radius: 20px; padding: 2px 10px; font-size: 11px; font-weight: 500; }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card" style="max-width:760px;">

        <div class="user-header">
            @if (Model.PathImage != null)
            {
                <img class="user-avatar" src="@(ViewData["URLAPI"] + Model.PathImage)" alt="@Model.Firstname @Model.LastName" />
            }
            else
            {
                <div class="user-avatar-placeholder">
                    @(Model.Firstname?.Length > 0 ? Model.Firstname[0].ToString() : "")@(Model.LastName?.Length > 0 ? Model.LastName[0].ToString() : "")
                </div>
            }
            <div class="user-header-info">
                <p class="user-header-eyebrow">Profil utilisateur</p>
                <p class="user-header-name">@Model.Firstname @Model.LastName</p>
                @if (Model.SessionStudents.LastOrDefault() != null)
                {
                    <span class="user-header-class">
                        <i class="fas fa-door-open" style="font-size:11px;color:#aaa;"></i>
                        @Model.SessionStudents.LastOrDefault().Session.SchoolClassRoom.SchoolClassRoomName
                    </span>
                }
            </div>
            <div class="user-header-actions">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="hw-btn-edit">
                    <i class="fas fa-pen"></i> Modifier
                </a>
                <a asp-action="Index" class="hw-back">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        </div>

        <div class="user-body">

            <p class="user-section-title">Informations personnelles</p>
            <div class="user-grid">
                <div class="user-field">
                    <div class="user-field-label">@Html.DisplayNameFor(model => model.Firstname)</div>
                    <div class="user-field-value">@Model.Firstname</div>
                </div>
                <div class="user-field">
                    <div class="user-field-label">@Html.DisplayNameFor(model => model.LastName)</div>
                    <div class="user-field-value">@Model.LastName</div>
                </div>
                <div class="user-field">
                    <div class="user-field-label">@Html.DisplayNameFor(model => model.Gender)</div>
                    <div class="user-field-value">@Model.Gender?.GenderName</div>
                </div>
                <div class="user-field">
                    <div class="user-field-label">@Html.DisplayNameFor(model => model.Birthday)</div>
                    <div class="user-field-value">@Model.Birthday.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="user-field">
                    <div class="user-field-label">@Html.DisplayNameFor(model => model.Nationality)</div>
                    <div class="user-field-value">@Model.Nationality</div>
                </div>
                <div class="user-field">
                    <div class="user-field-label">@Html.DisplayNameFor(model => model.Language)</div>
                    <div class="user-field-value">@Model.Language</div>
                </div>
            </div>

            <p class="user-section-title">Contact & compte</p>
            <div class="user-grid">
                <div class="user-field">
                    <div class="user-field-label">@Html.DisplayNameFor(model => model.Email)</div>
                    <div class="user-field-value">
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    </div>
                </div>
                <div class="user-field">
                    <div class="user-field-label">@Html.DisplayNameFor(model => model.PhoneNumber)</div>
                    <div class="user-field-value">
                        <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a>
                    </div>
                </div>
                <div class="user-field">
                    <div class="user-field-label">@Html.DisplayNameFor(model => model.UserName)</div>
                    <div class="user-field-value">@Model.UserName</div>
                </div>
            </div>

            <p class="user-section-title">Préférences</p>
            <div class="user-grid">
                <div class="user-field">
                    <div class="user-field-label">@Html.DisplayNameFor(model => model.WantsMoreHomeworks)</div>
                    <div class="user-field-value">
                        @if (Model.WantsMoreHomeworks)
                        {
                            <span class="user-bool-yes"><i class="fas fa-check" style="font-size:10px;"></i> Oui</span>
                        }
                        else
                        {
                            <span class="user-bool-no"><i class="fas fa-minus" style="font-size:10px;"></i> Non</span>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>