@model mvc.Models.ExercicesAlone

@{
    ViewData["Title"] = "Exercice";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }
    .hw-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
    .hw-topbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 1.5rem 1rem; border-bottom: 1px solid #f1f3f9; gap: 12px; flex-wrap: wrap; }
    .hw-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 4px; }
    .hw-title { font-family: 'Lora', serif; font-size: 22px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .hw-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #6c757d; text-decoration: none; border: 1px solid #eef0f7; border-radius: 10px; padding: 7px 14px; transition: all 0.15s; }
    .hw-back:hover { background: #f8f9fc; color: #1a1a2e; text-decoration: none; }
    .hw-body { padding: 1.5rem; }
    .hw-section-header { font-family: 'Lora', serif; font-size: 16px; font-weight: 600; color: #fff; background: #1a1a2e; border-radius: 10px; padding: 10px 16px; margin: 1.5rem 0 1rem; }
    .hw-section-header.correction { background: #2c5f2e; }
    .hw-section-header.video { background: #1a3a5c; }
    .hw-section-header.exercice { background: #3a1a5c; }
    .hw-student-header { font-family: 'Lora', serif; font-size: 16px; font-weight: 600; color: #1a1a2e; border-bottom: 2px solid #f1f3f9; padding-bottom: 8px; margin: 1.5rem 0 0.75rem; }
    .hw-student-meta { font-size: 12px; color: #aaa; margin-bottom: 1rem; }
    .hw-download-btn { display: inline-flex; align-items: center; gap: 6px; background: #1a1a2e; color: #fff; border-radius: 10px; padding: 9px 18px; font-size: 13px; font-weight: 500; text-decoration: none; transition: opacity 0.15s; margin-top: 10px; }
    .hw-download-btn:hover { opacity: 0.8; color: #fff; text-decoration: none; }
    .hw-save-btn { display: inline-flex; align-items: center; gap: 6px; background: #2c7a2e; color: #fff; border: none; border-radius: 10px; padding: 9px 18px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: opacity 0.15s; width: 100%; justify-content: center; margin-bottom: 10px; }
    .hw-save-btn:hover { opacity: 0.85; }
    .hw-comment-textarea { width: 100%; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; padding: 9px 14px; font-size: 13px; color: #1a1a2e; font-family: 'DM Sans', sans-serif; outline: none; transition: border-color 0.15s; resize: vertical; }
    .hw-comment-textarea:focus { border-color: #c0c8e8; background: #fff; }
    .hw-comment-submit { display: inline-flex; align-items: center; gap: 6px; background: #1a1a2e; color: #fff; border: none; border-radius: 10px; padding: 8px 18px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: opacity 0.15s; width: 100%; justify-content: center; margin-top: 8px; }
    .hw-comment-submit:hover { opacity: 0.8; }
    .hw-delete-link { background: none; border: none; color: #A32D2D; font-size: 12px; cursor: pointer; padding: 4px 0; text-decoration: underline; }
    .hw-teacher-comment { background: #FCEBEB; border: 1px solid #F09595; border-radius: 10px; padding: 12px 14px; font-size: 13px; color: #A32D2D; font-weight: 500; margin-bottom: 10px; }
    .hw-upload-label { display: flex; align-items: center; justify-content: center; gap: 6px; background: #2c7a2e; color: #fff; border-radius: 10px; padding: 10px 18px; font-size: 13px; font-weight: 500; cursor: pointer; transition: opacity 0.15s; margin-top: 1rem; }
    .hw-upload-label:hover { opacity: 0.85; }
    .hw-teacher-links { display: flex; gap: 12px; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #f1f3f9; }
    .hw-link-edit { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; color: #2c7a2e; text-decoration: none; }
    .hw-link-edit:hover { text-decoration: underline; color: #2c7a2e; }
    .hw-link-delete { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; color: #A32D2D; text-decoration: none; }
    .hw-link-delete:hover { text-decoration: underline; color: #A32D2D; }

    /* Syncfusion image editor */
    .image-editor { margin: 0 auto; }
    .e-img-editor-sample { height: 80vh; width: 100%; }
    @@media only screen and (max-width: 700px) {
        .e-img-editor-sample { height: 75vh; width: 100%; }
    }
    .control-wrapper { height: 100%; }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Exercices en Autonomie</p>
                <h1 class="hw-title">@Html.DisplayFor(model => model.ExerciceName)</h1>
            </div>
            <a href="javascript:history.back()" class="hw-back">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>

        <div class="hw-body">

            @* ── Correction (si disponible) ── *@
            @if (Model.CorrectionDate <= DateTime.Now)
            {
                <div class="hw-section-header correction"><i class="fas fa-graduation-cap" style="margin-right:8px;"></i>Correction</div>
                @if (Model.CorrectionLink != null)
                {
                    @if (Model.CorrectionLink.ToLower().EndsWith("pdf"))
                    {
                        <ejs-pdfviewer id="pdfviewer" serviceUrl="@ViewData["URLAPI"]api/PdfViewer" documentPath="@Model.CorrectionLink">
                        </ejs-pdfviewer>
                    }
                    else
                    {
                        <div class="embed-responsive embed-responsive-1by1">
                            @if (!Model.CorrectionLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                            {
                                <iframe class="embed-responsive-item" src="@ViewData["URLAPI"]@Html.DisplayFor(model => model.CorrectionLink)" allowfullscreen></iframe>
                            }
                            else
                            {
                                <iframe class="embed-responsive-item" src="@Html.DisplayFor(model => model.CorrectionLink)" allowfullscreen></iframe>
                            }
                        </div>
                    }
                    @if (!Model.CorrectionLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                    {
                        <a class="hw-download-btn" href="@ViewData["URLAPI"]@Html.DisplayFor(model => model.CorrectionLink)">
                            <i class="fas fa-download"></i> Télécharger la correction
                        </a>
                    }
                    else
                    {
                        <a class="hw-download-btn" href="@Html.DisplayFor(model => model.CorrectionLink)">
                            <i class="fas fa-download"></i> Télécharger la correction
                        </a>
                    }
                }
            }

            @* ── Devoirs rendus par les élèves ── *@
            @foreach (var homework in Model.HomeworkV2studentExerciceAlones)
            {
                <div>
                    @if (User.Identity.Name == homework.Student.UserName)
                    {
                        <div class="hw-student-header">Mon exercice</div>
                    }
                    else
                    {
                        <div class="hw-student-header">Exercice de @homework.Student.Firstname</div>
                        <div class="hw-student-meta">Rendu le @homework.HomeworkStudentDate.ToString("dd MMMM yyyy à HH:mm")</div>
                    }

                    @if (homework.HomeworkFileType?.Contains("audio") ?? false)
                    {
                        <audio controls style="width: 100%;">
                            <source src="@(ViewData["URLAPI"]+homework.HomeworkFile)" type="@homework.HomeworkFileType">
                            Il y a un problème avec le fichier mp3.
                        </audio>
                    }
                    else if (homework.HomeworkFileType?.Contains("video") ?? false)
                    {
                        <video controls style="width: 100%;">
                            <source src="@(ViewData["URLAPI"]+homework.HomeworkFile)" type="@homework.HomeworkFileType">
                            Your browser does not support the video tag.
                        </video>
                    }
                    else if (homework.HomeworkFileType?.Contains("image") ?? false || string.IsNullOrEmpty(homework.HomeworkFileType))
                    {
                        <div class="control-section e-img-editor-sample">
                            @if ((bool)ViewData["IsTeacher"])
                            {
                                <ejs-imageeditor id="image-editor-@homework.HomeworkV2studentId"
                                     data-id="@homework.HomeworkV2studentId"
                                     data-url="@ViewData["URLAPI"]@homework.HomeworkFile"
                                     data-api-url="@ViewData["URLAPI"]api/UploadFiles/UploadHomeworkStudentLive"></ejs-imageeditor>
                            }
                            else
                            {
                                <a href="@ViewData["URLAPI"]@homework.HomeworkFile">
                                    <ejs-imageeditor id="image-editor-@homework.HomeworkV2studentId"
                                         toolbar="Array.Empty<string>()"
                                         data-id="@homework.HomeworkV2studentId"
                                         data-url="@ViewData["URLAPI"]@homework.HomeworkFile"
                                         data-api-url="@ViewData["URLAPI"]api/UploadFiles/UploadHomeworkStudentLive">
                                    </ejs-imageeditor>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <a href="@(ViewData["URLAPI"]+homework.HomeworkFile)" download>Format inconnu — cliquer pour télécharger</a>
                    }

                    @if ((bool)ViewData["IsTeacher"])
                    {
                        if (homework.HomeworkFileType?.Contains("image") ?? false || string.IsNullOrEmpty(homework.HomeworkFileType))
                        {
                            <button type="button" class="hw-save-btn" onclick='saveSyncfusionImage("image-editor-@homework.HomeworkV2studentId", "@ViewData["URLAPI"]api/UploadFiles/UploadHomeworkStudentExerciceAloneLive", @homework.HomeworkV2studentId)'>
                                <i class="fas fa-paper-plane"></i> Envoyer la correction
                            </button>
                        }
                        <form asp-controller="HomeworkV2studentExerciceAlones" asp-action="Edit">
                            <input type="hidden" name="id" value="@homework.HomeworkV2studentId" />
                            <input type="hidden" name="ExerciceId" value="@homework.ExerciceId" />
                            <input type="hidden" name="HomeworkV2studentId" value="@homework.HomeworkV2studentId" />
                            <div style="margin-bottom:8px;">
                                <textarea class="hw-comment-textarea" name="HomeworkCommentaryTeacher" rows="3">@homework.HomeworkCommentaryTeacher</textarea>
                            </div>
                            <button type="submit" class="hw-comment-submit"><i class="fas fa-comment"></i> Enregistrer le commentaire</button>
                        </form>
                    }
                    else
                    {
                        if (homework.HomeworkCommentaryTeacher != null && homework.HomeworkCommentaryTeacher != "")
                        {
                            <div class="hw-teacher-comment">@homework.HomeworkCommentaryTeacher</div>
                        }
                    }

                    <form asp-controller="HomeworkV2studentExerciceAlones" asp-action="Delete" style="margin-top:6px;">
                        <input type="hidden" name="id" value="@homework.HomeworkV2studentId" />
                        <button type="submit" class="hw-delete-link">Supprimer</button>
                    </form>
                </div>
            }

            @if (Model.HomeworkV2studentExerciceAlones.Count > 0)
            {
                <div style="margin-top: 2rem;"></div>
            }

            @* ── Audios ── *@
            @if (Model.AudioLink != null)
            {
                <audio controls style="width: 100%; margin-bottom: 10px;">
                    @if (Model.AudioLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                    {
                        <source src="@Html.DisplayFor(model => model.AudioLink)" type="audio/mp3">
                    }
                    else
                    {
                        <source src="@ViewData["URLAPI"]@Html.DisplayFor(model => model.AudioLink)" type="audio/mp3">
                    }
                    Il y a un problème avec le fichier mp3.
                </audio>
            }
            @if (Model.AudioLinkSecond != null)
            {
                <audio controls style="width: 100%; margin-bottom: 10px;">
                    @if (Model.AudioLinkSecond.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                    {
                        <source src="@Html.DisplayFor(model => model.AudioLinkSecond)" type="audio/mp3">
                    }
                    else
                    {
                        <source src="@ViewData["URLAPI"]@Html.DisplayFor(model => model.AudioLinkSecond)" type="audio/mp3">
                    }
                    Il y a un problème avec le fichier mp3.
                </audio>
            }
            @if (Model.AudioLinkThird != null)
            {
                <audio controls style="width: 100%; margin-bottom: 10px;">
                    @if (Model.AudioLinkThird.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                    {
                        <source src="@Html.DisplayFor(model => model.AudioLinkThird)" type="audio/mp3">
                    }
                    else
                    {
                        <source src="@ViewData["URLAPI"]@Html.DisplayFor(model => model.AudioLinkThird)" type="audio/mp3">
                    }
                    Il y a un problème avec le fichier mp3.
                </audio>
            }

            @* ── Vidéo ── *@
            @if (Model.VideoLink != null)
            {
                <div class="hw-section-header video"><i class="fas fa-film" style="margin-right:8px;"></i>Vidéo</div>
                <div class="embed-responsive embed-responsive-16by9">
                    @if (!Model.VideoLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                    {
                        <iframe class="embed-responsive-item" src="@ViewData["URLAPI"]@Html.DisplayFor(model => model.VideoLink)" allowfullscreen></iframe>
                    }
                    else
                    {
                        <iframe class="embed-responsive-item" src="@Html.DisplayFor(model => model.VideoLink)" allowfullscreen></iframe>
                    }
                </div>
            }

            @* ── Exercice ── *@
            <div class="hw-section-header exercice"><i class="fas fa-file-alt" style="margin-right:8px;"></i>Exercice</div>
            @if (Model.ExerciceLink != null)
            {
                @if (Model.ExerciceLink.ToLower().EndsWith("pdf"))
                {
                    <ejs-pdfviewer id="pdfviewer2" serviceUrl="@ViewData["URLAPI"]api/PdfViewer" documentPath="@Model.ExerciceLink">
                    </ejs-pdfviewer>
                }
                else
                {
                    <div class="embed-responsive embed-responsive-1by1">
                        @if (!Model.ExerciceLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                        {
                            <iframe class="embed-responsive-item" src="@ViewData["URLAPI"]@Html.DisplayFor(model => model.ExerciceLink)" allowfullscreen></iframe>
                        }
                        else
                        {
                            <iframe class="embed-responsive-item" src="@Html.DisplayFor(model => model.ExerciceLink)" allowfullscreen></iframe>
                        }
                    </div>
                }
                @if (!Model.ExerciceLink.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                {
                    <a class="hw-download-btn" href="@ViewData["URLAPI"]@Html.DisplayFor(model => model.ExerciceLink)">
                        <i class="fas fa-download"></i> Télécharger l'exercice
                    </a>
                }
                else
                {
                    <a class="hw-download-btn" href="@Html.DisplayFor(model => model.ExerciceLink)">
                        <i class="fas fa-download"></i> Télécharger l'exercice
                    </a>
                }
            }

            @* ── Remise de devoir (élève) ── *@
            @if (ViewData["IsStudent"] != null && (bool)ViewData["IsStudent"])
            {
                @if (Model.ExerciceLink != null)
                {
                    if (!Model.ExerciceLink.Contains("forms"))
                    {
                        <form id="formDevoirsEleves" asp-controller="HomeworkV2studentExerciceAlones" asp-action="Create" enctype="multipart/form-data" style="margin-top:1.5rem;">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" name="id" value="@Model.ExerciceId" />
                            <label class="hw-upload-label" for="devoirsEleves">
                                <i class="fas fa-upload"></i> Rendre mon devoir (images)
                                <input id="devoirsEleves" name="files" type="file" accept="image/*" multiple style="display:none">
                            </label>
                        </form>
                    }
                }
                else
                {
                    <form id="formDevoirsEleves" asp-controller="HomeworkV2studentExerciceAlones" asp-action="Create" enctype="multipart/form-data" style="margin-top:1.5rem;">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" name="id" value="@Model.ExerciceId" />
                        <label class="hw-upload-label" for="devoirsEleves">
                            <i class="fas fa-upload"></i> Rendre mon devoir
                            <input id="devoirsEleves" name="files" type="file" multiple style="display:none">
                        </label>
                    </form>
                }
            }

            @* ── Liens formateur ── *@
            @if (ViewData["IsTeacher"] != null && (bool)ViewData["IsTeacher"])
            {
                <div class="hw-teacher-links">
                    <a asp-action="Edit" asp-route-id="@Model.ExerciceId" class="hw-link-edit">
                        <i class="fas fa-pen"></i> Modifier
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.ExerciceId" class="hw-link-delete">
                        <i class="fas fa-trash"></i> Supprimer
                    </a>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <script>
        if (document.getElementById('correctionProf') !== null) {
            document.getElementById("correctionProf").onchange = function () {
                console.log('Correction is send.');
                document.getElementById("formDevoirsProfs").submit();
            };
        }

        if (document.getElementById('devoirsEleves') !== null) {
            document.getElementById("devoirsEleves").onchange = function () {
                if (confirm('Etes vous sûr-e de vouloir envoyer votre devoir ?')) {
                    document.getElementById("formDevoirsEleves").submit();
                } else {
                    console.log('Thing was not saved to the server.');
                    document.getElementById("devoirsEleves").value = "";
                }
            };
        }

        document.addEventListener("DOMContentLoaded", function () {
            var editors = document.querySelectorAll("[id^='image-editor-']");
            editors.forEach(function (editor) {
                var elementId = editor.id;
                var id = editor.getAttribute("data-id");
                var url = editor.getAttribute("data-url");
                var apiUrl = editor.getAttribute("data-api-url");

                openSyncfusionImageEditor(elementId, url, apiUrl, id);
            });
        });
    </script>
}
