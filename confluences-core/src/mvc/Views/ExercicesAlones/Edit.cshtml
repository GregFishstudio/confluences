@model mvc.Models.ExercicesAlone

@{
    ViewData["Title"] = "Modifier l'exercice";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }
    .hw-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
    .hw-topbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 1.5rem 1rem; border-bottom: 1px solid #f1f3f9; gap: 12px; flex-wrap: wrap; }
    .hw-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 4px; }
    .hw-title { font-family: 'Lora', serif; font-size: 22px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .hw-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #6c757d; text-decoration: none; border: 1px solid #eef0f7; border-radius: 10px; padding: 7px 14px; transition: all 0.15s; }
    .hw-back:hover { background: #f8f9fc; color: #1a1a2e; text-decoration: none; }
    .hw-form-body { padding: 2rem 1.5rem; }
    .hw-field { margin-bottom: 1.25rem; }
    .hw-label { display: block; font-size: 12px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: #aaa; margin-bottom: 6px; }
    .hw-input { width: 100%; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; padding: 9px 14px; font-size: 13px; color: #1a1a2e; font-family: 'DM Sans', sans-serif; outline: none; transition: border-color 0.15s, background 0.15s; }
    .hw-input:focus { border-color: #c0c8e8; background: #fff; box-shadow: 0 0 0 3px rgba(78,115,223,0.08); }
    .hw-select { width: 100%; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; padding: 9px 14px; font-size: 13px; color: #1a1a2e; font-family: 'DM Sans', sans-serif; outline: none; transition: border-color 0.15s, background 0.15s; appearance: none; -webkit-appearance: none; }
    .hw-select:focus { border-color: #c0c8e8; background: #fff; box-shadow: 0 0 0 3px rgba(78,115,223,0.08); }
    .hw-select-wrap { position: relative; }
    .hw-select-wrap::after { content: '\f078'; font-family: 'Font Awesome 5 Free'; font-weight: 900; position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 11px; color: #aaa; pointer-events: none; }
    .hw-validation { font-size: 12px; color: #A32D2D; margin-top: 4px; }
    .hw-resource-box { border: 1px solid #eef0f7; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; background: #fafbfe; }
    .hw-resource-title { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #aaa; margin: 0 0 10px; }
    .hw-or { text-align: center; font-size: 11px; color: #bbb; margin: 8px 0; }
    .hw-file-label { display: flex; align-items: center; justify-content: center; gap: 6px; background: #f8f9fc; border: 1px dashed #c0c8e8; border-radius: 10px; padding: 8px 16px; font-size: 13px; color: #6c757d; cursor: pointer; transition: all 0.15s; }
    .hw-file-label:hover { background: #eef0f7; border-color: #a0a8d0; }
    .hw-checkbox-field { display: flex; align-items: center; gap: 10px; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; padding: 10px 14px; margin-bottom: 1.25rem; }
    .hw-checkbox-field input[type="checkbox"] { width: 16px; height: 16px; accent-color: #1a1a2e; cursor: pointer; }
    .hw-checkbox-field label { font-size: 13px; color: #1a1a2e; margin: 0; cursor: pointer; }
    .hw-btn-save { display: inline-flex; align-items: center; gap: 6px; background: #1a1a2e; color: #fff; border: none; border-radius: 10px; padding: 9px 20px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: opacity 0.15s; }
    .hw-btn-save:hover { opacity: 0.8; }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card" style="max-width:720px;">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Exercices en Autonomie</p>
                <h1 class="hw-title">Modifier l'exercice</h1>
            </div>
            <a href="javascript:history.back()" class="hw-back">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>

        <form enctype="multipart/form-data" asp-action="Edit" class="hw-form-body">
            <div asp-validation-summary="ModelOnly" class="hw-validation" style="margin-bottom:1rem;"></div>
            <input type="hidden" asp-for="ExerciceId" />

            <div class="hw-field">
                <label asp-for="ExerciceDate" class="hw-label"></label>
                <input asp-for="ExerciceDate" type="text" class="hw-input datepicker" value="@Model.ExerciceDate.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="ExerciceDate" class="hw-validation"></span>
            </div>

            <div class="hw-field">
                <label asp-for="ExerciceName" class="hw-label"></label>
                <input asp-for="ExerciceName" class="hw-input" />
                <span asp-validation-for="ExerciceName" class="hw-validation"></span>
            </div>

            <div class="hw-resource-box">
                <p class="hw-resource-title"><i class="fas fa-video" style="margin-right:5px;"></i>Vidéo</p>
                <div class="hw-field" style="margin-bottom:8px;">
                    <label asp-for="VideoLink" class="hw-label">Lien URL</label>
                    <input asp-for="VideoLink" class="hw-input" placeholder="https://..." />
                    <span asp-validation-for="VideoLink" class="hw-validation"></span>
                </div>
                <div class="hw-or">— ou —</div>
                <label class="hw-file-label" for="fileVideo">
                    <i class="fas fa-paperclip"></i> Choisir un fichier vidéo
                    <input id="fileVideo" name="fileVideo" type="file" multiple style="display:none">
                </label>
            </div>

            <div class="hw-resource-box">
                <p class="hw-resource-title"><i class="fas fa-headphones" style="margin-right:5px;"></i>Audio principal</p>
                <div class="hw-field" style="margin-bottom:8px;">
                    <label asp-for="AudioLink" class="hw-label">Lien URL</label>
                    <input asp-for="AudioLink" class="hw-input" placeholder="https://..." />
                    <span asp-validation-for="AudioLink" class="hw-validation"></span>
                </div>
                <div class="hw-or">— ou —</div>
                <label class="hw-file-label" for="fileAudio">
                    <i class="fas fa-paperclip"></i> Choisir un fichier audio
                    <input id="fileAudio" name="fileAudio" type="file" multiple style="display:none">
                </label>
            </div>

            <div class="hw-resource-box">
                <p class="hw-resource-title"><i class="fas fa-headphones" style="margin-right:5px;"></i>Audio secondaire</p>
                <div class="hw-field" style="margin-bottom:8px;">
                    <label asp-for="AudioLinkSecond" class="hw-label">Lien URL</label>
                    <input asp-for="AudioLinkSecond" class="hw-input" placeholder="https://..." />
                    <span asp-validation-for="AudioLinkSecond" class="hw-validation"></span>
                </div>
                <div class="hw-or">— ou —</div>
                <label class="hw-file-label" for="fileAudioSecond">
                    <i class="fas fa-paperclip"></i> Choisir un fichier audio
                    <input id="fileAudioSecond" name="fileAudioSecond" type="file" multiple style="display:none">
                </label>
            </div>

            <div class="hw-resource-box">
                <p class="hw-resource-title"><i class="fas fa-headphones" style="margin-right:5px;"></i>Audio tertiaire</p>
                <div class="hw-field" style="margin-bottom:8px;">
                    <label asp-for="AudioLinkThird" class="hw-label">Lien URL</label>
                    <input asp-for="AudioLinkThird" class="hw-input" placeholder="https://..." />
                    <span asp-validation-for="AudioLinkThird" class="hw-validation"></span>
                </div>
                <div class="hw-or">— ou —</div>
                <label class="hw-file-label" for="fileAudioThird">
                    <i class="fas fa-paperclip"></i> Choisir un fichier audio
                    <input id="fileAudioThird" name="fileAudioThird" type="file" multiple style="display:none">
                </label>
            </div>

            <div class="hw-resource-box">
                <p class="hw-resource-title"><i class="fas fa-file-alt" style="margin-right:5px;"></i>Fichier exercice</p>
                <div class="hw-field" style="margin-bottom:8px;">
                    <label asp-for="ExerciceLink" class="hw-label">Lien URL</label>
                    <input asp-for="ExerciceLink" class="hw-input" placeholder="https://..." />
                    <span asp-validation-for="ExerciceLink" class="hw-validation"></span>
                </div>
                <div class="hw-or">— ou —</div>
                <label class="hw-file-label" for="files">
                    <i class="fas fa-paperclip"></i> Choisir un fichier
                    <input id="files" name="files" type="file" style="display:none">
                </label>
            </div>

            <div class="hw-checkbox-field">
                <input type="checkbox" asp-for="IsHomeworkAdditionnal" id="IsHomeworkAdditionnal" />
                <label for="IsHomeworkAdditionnal">@Html.DisplayNameFor(model => model.IsHomeworkAdditionnal)</label>
            </div>

            <div class="hw-field">
                <label asp-for="CorrectionDate" class="hw-label"></label>
                <input asp-for="CorrectionDate" type="text" class="hw-input datetimepicker" value="@Model.CorrectionDate" />
                <span asp-validation-for="CorrectionDate" class="hw-validation"></span>
            </div>

            <div class="hw-resource-box">
                <p class="hw-resource-title"><i class="fas fa-graduation-cap" style="margin-right:5px;"></i>Correction</p>
                <div class="hw-field" style="margin-bottom:8px;">
                    <label asp-for="CorrectionLink" class="hw-label">Lien URL</label>
                    <input asp-for="CorrectionLink" class="hw-input" placeholder="https://..." />
                    <span asp-validation-for="CorrectionLink" class="hw-validation"></span>
                </div>
                <div class="hw-or">— ou —</div>
                <label class="hw-file-label" for="filesCorrection">
                    <i class="fas fa-paperclip"></i> Choisir un fichier correction
                    <input id="filesCorrection" name="filesCorrection" type="file" style="display:none">
                </label>
            </div>

            <div class="hw-field">
                <label asp-for="TeacherId" class="hw-label"></label>
                <div class="hw-select-wrap">
                    <select asp-for="TeacherId" class="hw-select" asp-items="ViewBag.TeacherId"></select>
                </div>
                <span asp-validation-for="TeacherId" class="hw-validation"></span>
            </div>

            <div class="hw-field">
                <label asp-for="HomeworkV2id" class="hw-label"></label>
                <div class="hw-select-wrap">
                    <select asp-for="HomeworkV2id" class="hw-select" asp-items="ViewBag.HomeworkV2id"></select>
                </div>
                <span asp-validation-for="HomeworkV2id" class="hw-validation"></span>
            </div>

            <button type="submit" class="hw-btn-save">
                <i class="fas fa-save"></i> Sauvegarder
            </button>
        </form>

    </div>
</div>

@section Scripts {
    <script>
        $('.datepicker').datetimepicker({
            locale: 'fr',
            format: 'yyyy-MM-DD',
            icons: {
                time: "fa fa-clock-o",
                date: "fa fa-calendar",
                up: "fa fa-chevron-up",
                down: "fa fa-chevron-down",
                previous: 'fa fa-chevron-left',
                next: 'fa fa-chevron-right',
                today: 'fa fa-screenshot',
                clear: 'fa fa-trash',
                close: 'fa fa-remove'
            }
        });
        $('.datetimepicker').datetimepicker({
            locale: 'fr',
            icons: {
                time: "fa fa-clock-o",
                date: "fa fa-calendar",
                up: "fa fa-chevron-up",
                down: "fa fa-chevron-down",
                previous: 'fa fa-chevron-left',
                next: 'fa fa-chevron-right',
                today: 'fa fa-screenshot',
                clear: 'fa fa-trash',
                close: 'fa fa-remove'
            }
        });
    </script>
}
