@model mvc.Models.HomeworkV2s

@{
    ViewData["Title"] = "Modifier un devoir";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');

    .hw-root { font-family: 'DM Sans', sans-serif; }

    .hw-card {
        background: #fff; border-radius: 20px;
        border: 1px solid #f1f3f9;
        box-shadow: 0 4px 24px rgba(0,0,0,0.04);
        overflow: hidden; margin-bottom: 2rem;
    }

    .hw-topbar {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.5rem 1.5rem 1rem;
        border-bottom: 1px solid #f1f3f9;
        gap: 12px; flex-wrap: wrap;
    }
    .hw-eyebrow {
        font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
        color: #aaa; margin: 0 0 4px;
    }
    .hw-title {
        font-family: 'Lora', serif; font-size: 22px; font-weight: 600;
        color: #1a1a2e; margin: 0;
    }
    .hw-back {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 13px; color: #6c757d; text-decoration: none;
        border: 1px solid #eef0f7; border-radius: 10px;
        padding: 7px 14px; transition: all 0.15s;
    }
    .hw-back:hover { background: #f8f9fc; color: #1a1a2e; text-decoration: none; }

    .hw-form-body { padding: 2rem 1.5rem; }

    .hw-field { margin-bottom: 1.25rem; }
    .hw-label {
        display: block; font-size: 12px; font-weight: 500;
        letter-spacing: 0.04em; text-transform: uppercase;
        color: #aaa; margin-bottom: 6px;
    }
    .hw-input,
    .hw-select {
        width: 100%; background: #f8f9fc;
        border: 1px solid #eef0f7; border-radius: 10px;
        padding: 9px 14px; font-size: 13px; color: #1a1a2e;
        font-family: 'DM Sans', sans-serif; outline: none;
        transition: border-color 0.15s, background 0.15s;
        appearance: none; -webkit-appearance: none;
    }
    .hw-input:focus, .hw-select:focus {
        border-color: #c0c8e8; background: #fff;
        box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.08);
    }
    .hw-select-wrap { position: relative; }
    .hw-select-wrap::after {
        content: '\f078'; font-family: 'Font Awesome 5 Free'; font-weight: 900;
        position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
        font-size: 11px; color: #aaa; pointer-events: none;
    }

    .hw-checkbox-field {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 14px; background: #f8f9fc;
        border: 1px solid #eef0f7; border-radius: 10px;
        cursor: pointer; margin-bottom: 1.25rem;
    }
    .hw-checkbox-field input[type="checkbox"] {
        width: 16px; height: 16px; accent-color: #1a1a2e; cursor: pointer;
    }
    .hw-checkbox-label {
        font-size: 13px; color: #1a1a2e; cursor: pointer; margin: 0;
    }

    .hw-validation { font-size: 12px; color: #A32D2D; margin-top: 4px; }

    .hw-actions {
        display: flex; align-items: center; gap: 10px;
        padding: 1.25rem 1.5rem; border-top: 1px solid #f1f3f9;
    }
    .hw-btn-save {
        display: inline-flex; align-items: center; gap: 6px;
        background: #1a1a2e; color: #fff;
        border: none; border-radius: 10px;
        padding: 9px 20px; font-size: 13px; font-weight: 500;
        cursor: pointer; font-family: 'DM Sans', sans-serif;
        transition: opacity 0.15s;
    }
    .hw-btn-save:hover { opacity: 0.8; }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card" style="max-width: 600px;">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Devoirs</p>
                <h1 class="hw-title">Modifier un devoir</h1>
            </div>
            <a asp-action="Index" asp-route-id="@Model.SessionId" class="hw-back">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>

        <form asp-action="Edit" class="hw-form-body">
            <div asp-validation-summary="ModelOnly" class="hw-validation" style="margin-bottom:1rem;"></div>
            <input type="hidden" asp-for="HomeworkV2id" />

            <div class="hw-field">
                <label asp-for="HomeworkV2date" class="hw-label"></label>
                <input asp-for="HomeworkV2date" type="text"
                       class="hw-input datetimepicker"
                       value="@Model.HomeworkV2date.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="HomeworkV2date" class="hw-validation"></span>
            </div>

            <div class="hw-field">
                <label asp-for="HomeworkTypeId" class="hw-label"></label>
                <div class="hw-select-wrap">
                    <select asp-for="HomeworkTypeId" class="hw-select" asp-items="ViewBag.HomeworkTypeId"></select>
                </div>
                <span asp-validation-for="HomeworkTypeId" class="hw-validation"></span>
            </div>

            <div class="hw-field">
                <label asp-for="HomeworkV2name" class="hw-label"></label>
                <input asp-for="HomeworkV2name" class="hw-input" />
                <span asp-validation-for="HomeworkV2name" class="hw-validation"></span>
            </div>

            <div class="hw-field">
                <label asp-for="SessionId" class="hw-label"></label>
                <div class="hw-select-wrap">
                    <select asp-for="SessionId" class="hw-select" asp-items="ViewBag.SessionId"></select>
                </div>
                <span asp-validation-for="SessionId" class="hw-validation"></span>
            </div>

            <div class="hw-field">
                <label asp-for="TeacherId" class="hw-label"></label>
                <div class="hw-select-wrap">
                    <select asp-for="TeacherId" class="hw-select" asp-items="ViewBag.TeacherId"></select>
                </div>
                <span asp-validation-for="TeacherId" class="hw-validation"></span>
            </div>

            <label class="hw-checkbox-field">
                <input type="checkbox" value="true" asp-for="IsFutur" />
                <span class="hw-checkbox-label">@Html.DisplayNameFor(model => model.IsFutur)</span>
            </label>

            <div class="hw-actions" style="padding: 0; border: none; margin-top: 0.5rem;">
                <button type="submit" class="hw-btn-save">
                    <i class="fas fa-save"></i> Sauvegarder
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $('.datetimepicker').datetimepicker({
            locale: 'fr',
            format: 'yyyy-MM-DD',
            icons: {
                time: "fa fa-clock-o",
                date: "fa fa-calendar",
                up: "fa fa-chevron-up",
                down: "fa fa-chevron-down",
                previous: 'fa fa-chevron-left',
                next: 'fa fa-chevron-right',
                today: 'fa fa-screenshot',
                clear: 'fa fa-trash',
                close: 'fa fa-remove'
            }
        });
    </script>
}