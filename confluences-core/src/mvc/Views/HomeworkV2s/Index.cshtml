@model IEnumerable<mvc.Models.HomeworkV2s>

@{
    ViewData["Title"] = "Devoirs";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');

    .hw-root { font-family: 'DM Sans', sans-serif; }

    .hw-card {
        background: #fff; border-radius: 20px;
        border: 1px solid #f1f3f9;
        box-shadow: 0 4px 24px rgba(0,0,0,0.04);
        overflow: hidden; margin-bottom: 2rem;
    }

    .hw-topbar {
        display: flex; justify-content: space-between; align-items: flex-start;
        padding: 1.5rem 1.5rem 1rem;
        border-bottom: 1px solid #f1f3f9;
        gap: 12px; flex-wrap: wrap;
    }
    .hw-eyebrow {
        font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
        color: #aaa; margin: 0 0 4px;
    }
    .hw-title {
        font-family: 'Lora', serif; font-size: 22px; font-weight: 600;
        color: #1a1a2e; margin: 0 0 2px;
    }
    .hw-subtitle { font-size: 13px; color: #6c757d; margin: 0; }

    .hw-btn-add {
        display: inline-flex; align-items: center; gap: 6px;
        background: #1a1a2e; color: #fff;
        border: none; border-radius: 10px;
        padding: 9px 18px; font-size: 13px; font-weight: 500;
        cursor: pointer; text-decoration: none;
        transition: opacity 0.15s;
    }
    .hw-btn-add:hover { opacity: 0.8; color: #fff; text-decoration: none; }

    .hw-stats {
        display: grid; grid-template-columns: repeat(3, 1fr);
        border-bottom: 1px solid #f1f3f9;
    }
    .hw-stat { padding: 1rem 1.5rem; border-right: 1px solid #f1f3f9; }
    .hw-stat:last-child { border-right: none; }
    .hw-stat-num { font-size: 26px; font-weight: 500; color: #1a1a2e; line-height: 1; }
    .hw-stat-label { font-size: 12px; color: #aaa; margin-top: 4px; }

    .hw-toolbar {
        display: flex; align-items: center; gap: 8px;
        padding: 12px 1.5rem; border-bottom: 1px solid #f1f3f9; flex-wrap: wrap;
    }
    .hw-search-wrap { position: relative; flex: 1; min-width: 180px; }
    .hw-search-wrap .search-icon {
        position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
        font-size: 14px; color: #aaa;
    }
    .hw-search {
        width: 100%; background: #f8f9fc;
        border: 1px solid #eef0f7; border-radius: 10px;
        padding: 7px 12px 7px 32px;
        font-size: 13px; color: #1a1a2e;
        font-family: 'DM Sans', sans-serif; outline: none;
    }
    .hw-search:focus { border-color: #c0c8e8; background: #fff; }

    .hw-filter-btn {
        display: inline-flex; align-items: center; gap: 5px;
        background: #f8f9fc; border: 1px solid #eef0f7;
        border-radius: 10px; padding: 7px 14px; font-size: 13px;
        color: #6c757d; cursor: pointer; font-family: 'DM Sans', sans-serif;
        transition: all 0.15s;
    }
    .hw-filter-btn:hover, .hw-filter-btn.active {
        background: #1a1a2e; color: #fff; border-color: #1a1a2e;
    }

    .hw-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .hw-table th {
        text-align: left; padding: 10px 1.5rem;
        font-size: 11px; font-weight: 500; letter-spacing: 0.06em;
        text-transform: uppercase; color: #aaa;
        border-bottom: 1px solid #f1f3f9; white-space: nowrap;
    }
    .hw-table td {
        padding: 13px 1.5rem; border-bottom: 1px solid #f1f3f9;
        vertical-align: middle; color: #1a1a2e;
    }
    .hw-table tbody tr:last-child td { border-bottom: none; }
    .hw-table tbody tr { transition: background 0.1s; }
    .hw-table tbody tr:hover { background: #fafbff; }

    .date-chip {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 12px; color: #6c757d;
    }
    .type-chip {
        display: inline-block; padding: 3px 10px;
        border-radius: 20px; font-size: 11px; font-weight: 500;
        letter-spacing: 0.04em; background: #E6F1FB; color: #0C447C;
    }
    .futur-badge {
        display: inline-block; padding: 3px 10px;
        border-radius: 20px; font-size: 11px; font-weight: 500;
        background: #EAF3DE; color: #3B6D11;
    }
    .past-badge {
        display: inline-block; padding: 3px 10px;
        border-radius: 20px; font-size: 11px; font-weight: 500;
        background: #f8f9fc; color: #aaa;
    }

    .actions-cell { display: flex; justify-content: flex-end; gap: 4px; }
    .act-btn {
        width: 30px; height: 30px; border-radius: 8px;
        border: 1px solid #eef0f7; background: #fff;
        display: inline-flex; align-items: center; justify-content: center;
        color: #6c757d; transition: all 0.15s; text-decoration: none; font-size: 13px;
    }
    .act-btn:hover { background: #f8f9fc; color: #1a1a2e; border-color: #c0c8e8; text-decoration: none; }
    .act-btn.del:hover { background: #FCEBEB; color: #A32D2D; border-color: #F09595; }

    .hw-footer {
        display: flex; justify-content: space-between; align-items: center;
        padding: 12px 1.5rem; border-top: 1px solid #f1f3f9;
        font-size: 12px; color: #aaa;
    }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Année scolaire</p>
                <h1 class="hw-title">Devoirs</h1>
                <p class="hw-subtitle">
                    @if (ViewData["SchoolClassRoomId"] != null && Model.Any())
                    {
                        <span>Classe <strong>@Model.First().Session.SchoolClassRoom.SchoolClassRoomName</strong></span>
                    }
                    else
                    {
                        <span>Liste globale des devoirs</span>
                    }
                </p>
            </div>
            <a class="hw-btn-add" asp-action="Create" asp-route-sessionid="@ViewData["SessionId"]">
                <i class="fas fa-plus"></i> Ajouter un devoir
            </a>
        </div>

        <div class="hw-stats">
            <div class="hw-stat">
                <div class="hw-stat-num">@Model.Count()</div>
                <div class="hw-stat-label">Total devoirs</div>
            </div>
            <div class="hw-stat">
                <div class="hw-stat-num">@Model.Count(h => h.IsFutur)</div>
                <div class="hw-stat-label">Devoirs futurs</div>
            </div>
            <div class="hw-stat">
                <div class="hw-stat-num">@Model.Select(h => h.HomeworkType?.HomeworkTypeId).Distinct().Count()</div>
                <div class="hw-stat-label">Types différents</div>
            </div>
        </div>

        <div class="hw-toolbar">
            <div class="hw-search-wrap">
                <i class="fas fa-search search-icon"></i>
                <input class="hw-search" type="search" id="hw-search" placeholder="Rechercher un devoir..." />
            </div>
            <button class="hw-filter-btn active" data-filter="all">Tous</button>
            <button class="hw-filter-btn" data-filter="futur">Futurs</button>
            <button class="hw-filter-btn" data-filter="past">Passés</button>
        </div>

        <div class="table-responsive">
            <table class="hw-table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.HomeworkV2date)</th>
                        <th>@Html.DisplayNameFor(model => model.HomeworkV2name)</th>
                        <th>@Html.DisplayNameFor(model => model.HomeworkType)</th>
                        <th>Statut</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody id="hw-body">
                    @foreach (var item in Model)
                    {
                        <tr data-futur="@item.IsFutur.ToString().ToLower()"
                            data-search="@item.HomeworkV2name @item.HomeworkType?.HomeworkTypeName">
                            <td>
                                <span class="date-chip">
                                    <i class="far fa-calendar-alt"></i>
                                    @item.HomeworkV2date.ToString("dd MMM yyyy")
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.HomeworkV2id"
                                   style="color:#1a1a2e; font-weight:500; text-decoration:none;">
                                    @item.HomeworkV2name
                                </a>
                            </td>
                            <td>
                                <span class="type-chip">@item.HomeworkType?.HomeworkTypeName</span>
                            </td>
                            <td>
                                @if (item.IsFutur)
                                {
                                    <span class="futur-badge">À venir</span>
                                }
                                else
                                {
                                    <span class="past-badge">Passé</span>
                                }
                            </td>
                            <td>
                                <div class="actions-cell">
                                    <a asp-action="Edit" asp-route-id="@item.HomeworkV2id" class="act-btn" title="Modifier">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.HomeworkV2id" class="act-btn" title="Détails">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.HomeworkV2id" class="act-btn del" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="hw-footer">
            <span id="hw-count"></span>
        </div>

    </div>
</div>

@section Scripts {
<script>
    (function () {
        var rows = Array.from(document.querySelectorAll('#hw-body tr'));
        var searchInput = document.getElementById('hw-search');
        var countEl = document.getElementById('hw-count');
        var currentFilter = 'all';

        function updateCount(n) {
            countEl.textContent = n + ' devoir' + (n > 1 ? 's' : '') + ' affiché' + (n > 1 ? 's' : '');
        }

        function applyFilters() {
            var q = searchInput.value.toLowerCase();
            var visible = 0;
            rows.forEach(function (row) {
                var isFutur = row.dataset.futur === 'true';
                var matchFilter = currentFilter === 'all'
                    || (currentFilter === 'futur' && isFutur)
                    || (currentFilter === 'past' && !isFutur);
                var matchSearch = !q || row.dataset.search.toLowerCase().includes(q);
                row.style.display = (matchFilter && matchSearch) ? '' : 'none';
                if (matchFilter && matchSearch) visible++;
            });
            updateCount(visible);
        }

        searchInput.addEventListener('input', applyFilters);

        document.querySelectorAll('.hw-filter-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.hw-filter-btn').forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                currentFilter = btn.dataset.filter;
                applyFilters();
            });
        });

        applyFilters();
    })();
</script>
}