@{
    ViewData["Title"] = "Accès restreint";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');
    .sp-root { font-family: 'DM Sans', sans-serif; color: #1a1a2e; }

    .sp-wrap {
        min-height: calc(100vh - 60px);
        display: flex; align-items: center; justify-content: center;
        padding: 2rem;
    }
    .sp-card {
        background: #fff; border-radius: 20px;
        border: 1px solid #f1f3f9;
        box-shadow: 0 2px 16px rgba(0,0,0,0.04);
        padding: 40px 36px; max-width: 560px; width: 100%;
        text-align: center;
    }
    .sp-icon {
        width: 60px; height: 60px; border-radius: 16px;
        background: #f8f9fc; border: 1px solid #eef0f7;
        display: flex; align-items: center; justify-content: center;
        font-size: 22px; color: #1a1a2e;
        margin: 0 auto 24px;
    }
    .sp-title {
        font-family: 'Lora', serif; font-size: 20px; font-weight: 600;
        color: #1a1a2e; margin: 0 0 8px;
    }
    .sp-sub { font-size: 13px; color: #6c757d; margin: 0 0 28px; line-height: 1.6; }

    .sp-items { display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px; }
    .sp-item {
        display: flex; align-items: flex-start; gap: 14px;
        background: #f8f9fc; border: 1px solid #eef0f7;
        border-radius: 12px; padding: 14px 16px; text-align: left;
    }
    .sp-item-icon {
        width: 34px; height: 34px; border-radius: 10px;
        background: #1a1a2e; color: #fff; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 13px;
    }
    .sp-item-title { font-size: 13px; font-weight: 500; color: #1a1a2e; margin: 0 0 3px; }
    .sp-item-text { font-size: 12px; color: #aaa; margin: 0; line-height: 1.5; }

    .sp-btn {
        display: inline-flex; align-items: center; gap: 6px;
        background: #1a1a2e; color: #fff; border-radius: 10px;
        padding: 9px 20px; font-size: 13px; font-weight: 500;
        text-decoration: none; transition: opacity 0.15s;
    }
    .sp-btn:hover { opacity: 0.8; color: #fff; text-decoration: none; }
</style>

<div class="sp-root">
    <div class="sp-wrap">
        <div class="sp-card">

            <div class="sp-icon">
                <i class="fas fa-user-shield"></i>
            </div>

            <h1 class="sp-title">Accès restreint</h1>
            <p class="sp-sub">Votre profil n'a pas encore été affecté à un groupe d'utilisateurs actif sur la plateforme.</p>

            <div class="sp-items">
                <div class="sp-item">
                    <div class="sp-item-icon"><i class="fas fa-user-tie"></i></div>
                    <div>
                        <p class="sp-item-title">Devenir formateur</p>
                        <p class="sp-item-text">Contactez l'administrateur du système pour obtenir les privilèges d'enseignement.</p>
                    </div>
                </div>
                <div class="sp-item">
                    <div class="sp-item-icon"><i class="fas fa-user-graduate"></i></div>
                    <div>
                        <p class="sp-item-title">Rejoindre une classe</p>
                        <p class="sp-item-text">Contactez votre formateur pour être ajouté à la liste des participants.</p>
                    </div>
                </div>
            </div>

            <a href="/" class="sp-btn">
                <i class="fas fa-arrow-left"></i> Retour à l'accueil
            </a>

        </div>
    </div>
</div>