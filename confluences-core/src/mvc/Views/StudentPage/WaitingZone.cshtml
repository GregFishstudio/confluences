@{
    ViewData["Title"] = "Accès restreint";
}

<style>
    :root {
        --bg-gradient: linear-gradient(135deg, #f0f4ff 0%, #f1fff5 50%, #ffffff 100%);
        --primary-modern: #4e73df;
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    }

    body, .bgImage {
        background: var(--bg-gradient) !important;
        background-attachment: fixed !important;
        background-image: none !important;
        font-family: 'Inter', sans-serif;
        color: #2e3d49;
        display: flex;
        align-items: center;
        min-height: 100vh;
        margin: 0;
    }

    .error-container {
        width: 100%;
        padding: 2rem;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 30px;
        padding: 3rem;
        box-shadow: var(--card-shadow);
        max-width: 700px;
        margin: 0 auto;
    }

    .icon-wrapper {
        width: 80px;
        height: 80px;
        background: rgba(78, 115, 223, 0.1);
        color: var(--primary-modern);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 2rem;
    }

    .status-title {
        font-weight: 800;
        font-size: 1.75rem;
        color: #2b2d42;
        margin-bottom: 1.5rem;
        line-height: 1.3;
    }

    .instruction-box {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        margin-top: 2rem;
        text-align: left;
        border: 1px solid rgba(0,0,0,0.03);
    }

    .instruction-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 1rem;
    }

    .instruction-item:last-child { margin-bottom: 0; }

    .bullet {
        width: 24px;
        height: 24px;
        background: var(--primary-modern);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        flex-shrink: 0;
        margin-top: 3px;
    }

    .btn-home {
        margin-top: 2.5rem;
        background: var(--primary-modern);
        color: white;
        padding: 0.8rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.2s;
    }

    .btn-home:hover {
        background: #224abe;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(78, 115, 223, 0.3);
    }
</style>

<div class="error-container">
    <div class="glass-card text-center">
        <div class="icon-wrapper">
            <i class="fas fa-user-shield"></i>
        </div>

        <h3 class="status-title">Cet utilisateur n'est ni un formateur ni un participant</h3>
        
        <p class="text-muted">Votre profil n'a pas encore été affecté à un groupe d'utilisateurs actif sur la plateforme.</p>

        <div class="instruction-box shadow-sm">
            <div class="instruction-item">
                <div class="bullet"><i class="fas fa-user-tie"></i></div>
                <div>
                    <h6 class="font-weight-bold mb-1">Devenir Formateur</h6>
                    <p class="small text-muted mb-0">Veuillez contacter l'administrateur du système pour obtenir les privilèges d'enseignement.</p>
                </div>
            </div>
            <hr class="my-3 opacity-5">
            <div class="instruction-item">
                <div class="bullet"><i class="fas fa-user-graduate"></i></div>
                <div>
                    <h6 class="font-weight-bold mb-1">Rejoindre une Classe</h6>
                    <p class="small text-muted mb-0">Veuillez contacter votre formateur pour être ajouté à la liste des participants.</p>
                </div>
            </div>
        </div>

        <a href="/" class="btn-home">
            <i class="fas fa-arrow-left mr-2"></i> Retour à l'accueil
        </a>
    </div>
</div>