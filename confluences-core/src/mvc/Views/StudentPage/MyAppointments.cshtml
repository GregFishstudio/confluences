@model mvc.Models.AspNetUser
@{
    ViewData["Title"] = "Mes rendez-vous";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');
    .sp-root { font-family: 'DM Sans', sans-serif; color: #1a1a2e; }

    .sp-page-header { margin-bottom: 2rem; }
    .sp-page-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 6px; }
    .sp-page-title { font-family: 'Lora', serif; font-size: 26px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .sp-page-sub { font-size: 13px; color: #6c757d; margin: 4px 0 0; }

    .sp-empty { background: #fff; border-radius: 18px; border: 1px solid #f1f3f9; padding: 48px 24px; text-align: center; color: #aaa; font-size: 13px; }
    .sp-empty i { font-size: 32px; margin-bottom: 12px; display: block; color: #eef0f7; }

    .sp-appt {
        background: #fff; border-radius: 18px; border: 1px solid #f1f3f9;
        box-shadow: 0 2px 16px rgba(0,0,0,0.04);
        display: flex; overflow: hidden; margin-bottom: 12px;
        transition: transform 0.15s, box-shadow 0.15s;
    }
    .sp-appt:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(0,0,0,0.07); }

    .sp-appt-bar { width: 6px; flex-shrink: 0; background: #1a1a2e; }
    .sp-appt-bar.weekly { background: #00B4B0; }

    .sp-appt-body { padding: 18px 20px; flex: 1; }
    .sp-appt-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
    .sp-appt-time { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; color: #1a1a2e; }
    .sp-appt-time i { font-size: 12px; color: #aaa; }
    .sp-appt-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 500; white-space: nowrap; }
    .sp-appt-badge.weekly { background: #e0fafa; color: #0c6b6a; }
    .sp-appt-badge.once   { background: #f8f9fc; color: #aaa; }

    .sp-appt-name { font-family: 'Lora', serif; font-size: 17px; font-weight: 600; color: #1a1a2e; margin: 0 0 6px; }
    .sp-appt-date { font-size: 12px; color: #aaa; display: flex; align-items: center; gap: 5px; margin-bottom: 14px; }
    .sp-appt-date i { font-size: 11px; }

    .sp-attendees { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .sp-attendees-label { font-size: 10px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: #aaa; margin-right: 4px; }
    .sp-attendee { display: inline-flex; align-items: center; gap: 5px; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 8px; padding: 3px 10px; font-size: 12px; color: #1a1a2e; }
</style>

<partial name="_Notification.cshtml" />

<div class="container-fluid py-4 px-md-4 sp-root">
    <div class="sp-page-header">
        <p class="sp-page-eyebrow">Planning</p>
        <h1 class="sp-page-title">Mes rendez-vous</h1>
        <p class="sp-page-sub">Consultez et gérez vos séances à venir</p>
    </div>

    <div style="max-width:680px;">
        @if (Model.AppointmentStudents == null || !Model.AppointmentStudents.Any())
        {
            <div class="sp-empty">
                <i class="far fa-calendar-alt"></i>
                Aucun rendez-vous planifié pour le moment.
            </div>
        }
        else
        {
            @foreach (AppointmentStudent appointmentStudents in Model.AppointmentStudents.OrderBy(a => a.Appointment.DateStart))
            {
                var app = appointmentStudents.Appointment;
                <div class="sp-appt">
                    <div class="sp-appt-bar @(app.IsWeekly ? "weekly" : "")"></div>
                    <div class="sp-appt-body">
                        <div class="sp-appt-top">
                            <div class="sp-appt-time">
                                <i class="far fa-clock"></i>
                                @app.DateStart.ToString("HH:mm") — @app.DateEnd.ToString("HH:mm")
                            </div>
                            @if (app.IsWeekly)
                            {
                                <span class="sp-appt-badge weekly"><i class="fas fa-redo-alt" style="font-size:10px; margin-right:4px;"></i>Hebdomadaire</span>
                            }
                            else
                            {
                                <span class="sp-appt-badge once">Séance unique</span>
                            }
                        </div>
                        <p class="sp-appt-name">@app.AppointmentName</p>
                        <p class="sp-appt-date">
                            <i class="far fa-calendar-alt"></i>
                            @if (app.IsWeekly)
                            {
                                <span>Chaque <strong>@app.DateStart.ToString("dddd")</strong></span>
                            }
                            else
                            {
                                <span>@app.DateStart.ToString("dddd dd MMMM yyyy")</span>
                            }
                        </p>
                        <div class="sp-attendees">
                            <span class="sp-attendees-label">Participants</span>
                            @foreach (var student in app.AppointmentStudents)
                            {
                                <span class="sp-attendee">
                                    <i class="fas fa-user-circle" style="font-size:11px; color:#aaa;"></i>
                                    @student.Student.Firstname
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>