@model mvc.Models.AspNetUser
@{
    ViewData["Title"] = "Mon Espace";
    var baseApiUrl = ViewData["URLAPI"];
    var currentUserName = ViewData["CurrentUserName"];
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');
    .sp-root { font-family: 'DM Sans', sans-serif; color: #1a1a2e; }

    .sp-hero {
        background: #0d1b3e; border-radius: 20px;
        padding: 28px 28px 24px; margin-bottom: 1.5rem;
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; flex-wrap: wrap; position: relative; overflow: hidden;
    }
    .sp-hero::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse 70% 80% at 100% 50%, rgba(0,180,176,0.15) 0%, transparent 70%);
    }
    .sp-hero-left { position: relative; }
    .sp-hero-greeting { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin: 0 0 4px; }
    .sp-hero-name { font-family: 'Lora', serif; font-size: 24px; font-weight: 600; color: #fff; margin: 0; }
    .sp-hero-sub { font-size: 13px; color: rgba(255,255,255,0.5); margin: 4px 0 0; }
    .sp-hero-date { font-size: 12px; color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.07); border-radius: 8px; padding: 6px 14px; position: relative; white-space: nowrap; }

    .sp-card { background: #fff; border-radius: 18px; border: 1px solid #f1f3f9; box-shadow: 0 2px 16px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 1.25rem; }
    .sp-card-header { display: flex; align-items: center; gap: 8px; padding: 14px 18px; border-bottom: 1px solid #f1f3f9; font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: #aaa; }
    .sp-card-header i { font-size: 14px; color: #1a1a2e; }

    .sp-welcome { background: #0d1b3e; border-radius: 18px; margin-bottom: 1.25rem; overflow: hidden; }
    .sp-welcome-inner { padding: 20px; }
    .sp-welcome-title { font-size: 14px; font-weight: 500; color: #fff; margin: 0 0 12px; display: flex; align-items: center; gap: 8px; }
    .sp-welcome-title i { color: #00B4B0; }
    .sp-lang-btns { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
    .sp-lang-btn { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15); color: #fff; border-radius: 8px; padding: 5px 12px; font-size: 12px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: all 0.15s; }
    .sp-lang-btn:hover { background: #00B4B0; border-color: #00B4B0; }
    .sp-got-it { display: inline-flex; align-items: center; gap: 6px; background: #00B4B0; color: #fff; border-radius: 10px; padding: 8px 18px; font-size: 13px; font-weight: 500; text-decoration: none; transition: opacity 0.15s; }
    .sp-got-it:hover { opacity: 0.85; color: #fff; text-decoration: none; }

    .sp-hw-type { font-size: 10px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: #aaa; padding: 10px 18px 4px; }
    .sp-hw-item { display: flex; align-items: center; gap: 12px; padding: 12px 18px; text-decoration: none; border-bottom: 1px solid #f1f3f9; transition: background 0.1s; }
    .sp-hw-item:last-child { border-bottom: none; }
    .sp-hw-item:hover { background: #fafbff; text-decoration: none; }
    .sp-hw-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .sp-hw-dot.today { background: #1a1a2e; }
    .sp-hw-dot.future { background: #00B4B0; }
    .sp-hw-name { font-size: 13px; font-weight: 500; color: #1a1a2e; margin: 0; flex: 1; }
    .sp-hw-date { font-size: 11px; color: #aaa; white-space: nowrap; }
    .sp-hw-arrow { font-size: 11px; color: #aaa; }

    .sp-teacher { display: flex; align-items: center; gap: 12px; padding: 12px 18px; border-bottom: 1px solid #f1f3f9; }
    .sp-teacher:last-child { border-bottom: none; }
    .sp-teacher-avatar { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 2px solid #f1f3f9; }
    .sp-teacher-name { font-size: 13px; font-weight: 500; color: #1a1a2e; flex: 1; }
    .sp-video-btn { width: 34px; height: 34px; border-radius: 10px; background: #f8f9fc; border: 1px solid #eef0f7; display: flex; align-items: center; justify-content: center; color: #6c757d; transition: all 0.15s; text-decoration: none; }
    .sp-video-btn:hover { background: #1a1a2e; color: #fff; border-color: #1a1a2e; text-decoration: none; }
    .sp-online-dot { width: 10px; height: 10px; border-radius: 50%; background: #dee2e6; border: 2px solid #fff; position: absolute; bottom: 0; right: 0; }

    .sp-student-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding: 16px 18px; }
    .sp-student-item { text-align: center; }
    .sp-student-avatar-wrap { position: relative; display: inline-block; margin-bottom: 4px; }
    .sp-student-avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid #f1f3f9; }
    .sp-student-name { font-size: 11px; color: #6c757d; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sp-student-call { font-size: 10px; color: #00B4B0; text-decoration: none; }
    .sp-student-call:hover { text-decoration: underline; }
</style>

<partial name="_Notification.cshtml" />
<partial name="_NotificationPrivate.cshtml" />

<div class="container-fluid py-4 px-md-4 sp-root">
    <div class="row">
        <div class="col-12">
            <div class="sp-hero">
                <div class="sp-hero-left">
                    <p class="sp-hero-greeting">Bienvenue</p>
                    <h1 class="sp-hero-name">Bonjour, @Model.Firstname</h1>
                    <p class="sp-hero-sub">Ravi de vous revoir dans votre espace d'apprentissage.</p>
                </div>
                <span class="sp-hero-date">@DateTime.Now.ToString("dd MMMM yyyy")</span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">

            @if (!Model.HasSeenHelpVideo)
            {
                var session = Model.SessionStudents.FirstOrDefault()?.Session;
                if (session != null)
                {
                    <div class="sp-welcome">
                        <div class="embed-responsive embed-responsive-16by9">
                            <iframe class="embed-responsive-item" src="@session.SchoolClassRoom.ExplanationVideoLink" allowfullscreen></iframe>
                        </div>
                        <div class="sp-welcome-inner">
                            <p class="sp-welcome-title"><i class="fas fa-headphones"></i> Traductions audio disponibles</p>
                            <div class="sp-lang-btns">
                                @foreach (var exp in session.SchoolClassRoom.SchoolClassRoomExplanations)
                                {
                                    <button type="button" class="sp-lang-btn" value="@exp.AudioLink">@exp.LanguageName</button>
                                }
                            </div>
                            <a class="sp-got-it" asp-controller="StudentPage" asp-action="IGetIt">
                                <i class="fas fa-check"></i> J'ai compris
                            </a>
                        </div>
                    </div>
                }
            }

            <div class="sp-card">
                <div class="sp-card-header">
                    <i class="fas fa-book-open"></i> Mon parcours
                </div>
                @{
                    var sessionData = Model.SessionStudents.FirstOrDefault()?.Session;
                }
                @if (sessionData?.HomeworkV2s != null && sessionData.HomeworkV2s.Any(h => h.HomeworkV2date.Date >= DateTime.Now.Date))
                {
                    var homeworks = sessionData.HomeworkV2s
                        .Where(h => h.HomeworkV2date.Date == DateTime.Now.Date || (h.HomeworkV2date.Date >= DateTime.Now.Date && h.IsFutur))
                        .OrderBy(h => h.HomeworkType.HomeworkOrder);
                    int currentType = 0;
                    @foreach (var hw in homeworks)
                    {
                        if (currentType != hw.HomeworkTypeId)
                        {
                            <div class="sp-hw-type">@hw.HomeworkType.HomeworkTypeName</div>
                            currentType = hw.HomeworkTypeId;
                        }
                        <a asp-controller="HomeworkV2s" asp-action="Details" asp-route-id="@hw.HomeworkV2id" class="sp-hw-item">
                            <span class="sp-hw-dot @(hw.HomeworkV2date.Date > DateTime.Now.Date ? "future" : "today")"></span>
                            <span class="sp-hw-name">@hw.HomeworkV2name</span>
                            <span class="sp-hw-date">@hw.HomeworkV2date.ToString("dd MMM")</span>
                            <i class="fas fa-chevron-right sp-hw-arrow"></i>
                        </a>
                    }
                }
                else
                {
                    <div style="padding:24px 18px; text-align:center; color:#aaa; font-size:13px;">
                        <i class="fas fa-check-circle" style="color:#00B4B0; margin-bottom:8px; font-size:20px; display:block;"></i>
                        Aucun devoir à venir pour le moment.
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sp-card">
                <div class="sp-card-header">
                    <i class="fas fa-chalkboard-teacher"></i> Formateurs
                </div>
                @foreach (var st in Model.SessionStudents.First().Session.SessionTeachers.OrderBy(s => s.Order))
                {
                    <div class="sp-teacher">
                        <div style="position:relative; flex-shrink:0;">
                            <img class="sp-teacher-avatar" src="@(baseApiUrl + st.Teacher.PathImage)" onerror="this.src='/img/avatar.jpg'" />
                            <div data-userconnected="@st.Teacher.UserName" class="userconnected sp-online-dot"></div>
                        </div>
                        <span class="sp-teacher-name">@st.Teacher.Firstname</span>
                        <a data-userConnected="@st.Teacher.UserName"
                           class="sp-video-btn callButton callUnAvailable"
                           href="@Url.Action("Private", "Jitsi", new { roomName = st.Teacher.UserName, isPrivateRoom = true })"
                           title="Appel vidéo">
                            <i class="fas fa-video" style="font-size:13px;"></i>
                        </a>
                    </div>
                }
            </div>

            <div class="sp-card">
                <div class="sp-card-header">
                    <i class="fas fa-users"></i> Ma classe
                </div>
                <div class="sp-student-grid">
                    @foreach (var ss in Model.SessionStudents.First().Session.SessionStudents)
                    {
                        if (ss.Student.UserName == currentUserName?.ToString()) continue;
                        <div class="sp-student-item">
                            <div class="sp-student-avatar-wrap">
                                <img class="sp-student-avatar" src="@(baseApiUrl + ss.Student.PathImage)" onerror="this.src='/img/avatar.jpg'" />
                                <div data-userconnected="@ss.Student.UserName" class="userconnected sp-online-dot"></div>
                            </div>
                            <span class="sp-student-name">@ss.Student.Firstname</span>
                            <a data-userConnected="@ss.Student.UserName"
                               href="@Url.Action("Private", "Jitsi", new { roomName = ss.Student.UserName, isPrivateRoom = true })"
                               class="sp-student-call callButton callUnAvailable">
                                <i class="fas fa-phone-alt" style="font-size:10px;"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="../Chat/ChatStudent.cshtml" />

@section Scripts {
<script>
    const App = {
        audio: new Audio(),
        init() {
            document.querySelectorAll("button[value]").forEach(btn => {
                btn.onclick = () => { this.audio.src = btn.value; this.audio.play(); };
            });
            if (window.connectionJitsi) connectionJitsi.start();
        }
    };
    $(document).ready(() => App.init());
    function insertMessage() {
        const input = document.getElementById('messageInput');
        if (!input.value.trim()) return;
        $.post("/Chat/StudentSendMessageToClassRoom", { message: input.value, userName: '@currentUserName' });
        input.value = '';
    }
</script>
}