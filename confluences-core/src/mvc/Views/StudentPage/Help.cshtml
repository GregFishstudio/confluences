@model mvc.Models.AspNetUser
@{
    ViewData["Title"] = "Centre d'aide";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');
    .sp-root { font-family: 'DM Sans', sans-serif; color: #1a1a2e; }

    .sp-page-header { margin-bottom: 2rem; }
    .sp-page-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 6px; }
    .sp-page-title { font-family: 'Lora', serif; font-size: 26px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .sp-page-sub { font-size: 13px; color: #6c757d; margin: 4px 0 0; }

    .sp-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 2px 16px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 1.5rem; }

    .sp-video-wrap { border-radius: 16px; overflow: hidden; margin-bottom: 1.5rem; border: 1px solid #f1f3f9; }

    .sp-lang-section { padding: 20px 24px; }
    .sp-lang-title { font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: #aaa; margin: 0 0 12px; }
    .sp-lang-btns { display: flex; flex-wrap: wrap; gap: 8px; }
    .sp-lang-btn {
        display: inline-flex; align-items: center; gap: 6px;
        background: #f8f9fc; border: 1px solid #eef0f7;
        border-radius: 10px; padding: 8px 16px;
        font-size: 13px; font-weight: 500; color: #1a1a2e;
        cursor: pointer; font-family: 'DM Sans', sans-serif;
        transition: all 0.15s;
    }
    .sp-lang-btn:hover { background: #1a1a2e; color: #fff; border-color: #1a1a2e; }
    .sp-lang-btn i { font-size: 12px; }

    .sp-empty { padding: 40px 24px; text-align: center; color: #aaa; font-size: 13px; }
    .sp-empty i { font-size: 28px; display: block; margin-bottom: 10px; color: #eef0f7; }

    .sp-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #aaa; text-decoration: none; transition: color 0.15s; margin-top: 1rem; }
    .sp-back:hover { color: #1a1a2e; text-decoration: none; }
</style>

<partial name="_Notification.cshtml" />

<div class="container-fluid py-4 px-md-4 sp-root">
    <div class="sp-page-header">
        <p class="sp-page-eyebrow">Support</p>
        <h1 class="sp-page-title">Centre d'aide</h1>
        <p class="sp-page-sub">Apprenez à utiliser votre espace de cours</p>
    </div>

    <div style="max-width:720px;">

        @if (Model.SessionStudents != null && Model.SessionStudents.Any())
        {
            var session = Model.SessionStudents.First().Session;

            <div class="sp-card">
                <div class="sp-video-wrap">
                    <div class="embed-responsive embed-responsive-16by9">
                        <iframe class="embed-responsive-item"
                                src="@session.SchoolClassRoom.ExplanationVideoLink"
                                allowfullscreen></iframe>
                    </div>
                </div>

                @if (session.SchoolClassRoom.SchoolClassRoomExplanations.Any())
                {
                    <div class="sp-lang-section">
                        <p class="sp-lang-title">Explications audio dans une autre langue</p>
                        <div class="sp-lang-btns">
                            @foreach (var explanation in session.SchoolClassRoom.SchoolClassRoomExplanations)
                            {
                                <button class="sp-lang-btn" value="@explanation.AudioLink">
                                    <i class="fas fa-volume-up"></i> @explanation.LanguageName
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="sp-card">
                <div class="sp-empty">
                    <i class="fas fa-exclamation-triangle"></i>
                    Aucune session active trouvée pour votre profil.
                </div>
            </div>
        }

        <a href="/" class="sp-back">
            <i class="fas fa-arrow-left"></i> Retour au tableau de bord
        </a>

    </div>
</div>

@section Scripts {
<script>
    const Soundboard = {
        audio: new Audio(),
        init() {
            document.querySelectorAll(".sp-lang-btn").forEach(btn => {
                btn.addEventListener("click", e => {
                    const url = e.currentTarget.value;
                    if (!url) return;
                    this.audio.src = url;
                    this.audio.play().catch(() => alert("Impossible de lire l'audio."));
                });
            });
        }
    };
    $(document).ready(() => Soundboard.init());
</script>
}