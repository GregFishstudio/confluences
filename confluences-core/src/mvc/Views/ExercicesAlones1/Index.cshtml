@model IEnumerable<mvc.Models.ExercicesAlone>

@{
    ViewData["Title"] = "Exercices en Autonomie";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }
    .hw-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
    .hw-topbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 1.5rem 1rem; border-bottom: 1px solid #f1f3f9; gap: 12px; flex-wrap: wrap; }
    .hw-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 4px; }
    .hw-title { font-family: 'Lora', serif; font-size: 22px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .hw-btn-new { display: inline-flex; align-items: center; gap: 6px; background: #1a1a2e; color: #fff; border-radius: 10px; padding: 9px 18px; font-size: 13px; font-weight: 500; text-decoration: none; transition: opacity 0.15s; white-space: nowrap; }
    .hw-btn-new:hover { opacity: 0.8; color: #fff; text-decoration: none; }
    .hw-toolbar { display: flex; align-items: center; gap: 10px; padding: 1rem 1.5rem; border-bottom: 1px solid #f1f3f9; }
    .hw-search { flex: 1; max-width: 320px; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; padding: 8px 14px; font-size: 13px; color: #1a1a2e; font-family: 'DM Sans', sans-serif; outline: none; }
    .hw-search:focus { border-color: #c0c8e8; background: #fff; }
    .hw-table { width: 100%; border-collapse: collapse; }
    .hw-table thead th { font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #aaa; padding: 10px 1.5rem; border-bottom: 1px solid #f1f3f9; text-align: left; background: #f8f9fc; white-space: nowrap; }
    .hw-table tbody tr { border-bottom: 1px solid #f1f3f9; transition: background 0.1s; }
    .hw-table tbody tr:hover { background: #fafbfe; }
    .hw-table tbody td { padding: 12px 1.5rem; font-size: 13px; color: #1a1a2e; vertical-align: middle; }
    .hw-date-block { display: flex; flex-direction: column; gap: 2px; }
    .hw-date-ex { font-size: 12px; font-weight: 500; color: #1a1a2e; }
    .hw-date-corr { font-size: 11px; color: #38a169; }
    .hw-exercice-name { font-weight: 600; color: #1a1a2e; }
    .hw-sub { font-size: 11px; color: #aaa; margin-top: 2px; }
    .hw-resource-icons { display: flex; gap: 5px; }
    .hw-ricon { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; text-decoration: none !important; font-size: 12px; transition: filter 0.15s; }
    .hw-ricon:hover { filter: brightness(0.92); text-decoration: none; }
    .hw-ricon-ex { background: #ebf8ff; color: #3182ce; }
    .hw-ricon-audio { background: #faf5ff; color: #805ad5; }
    .hw-ricon-corr { background: #f0fff4; color: #38a169; }
    .hw-badge { display: inline-block; padding: 3px 9px; border-radius: 6px; font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
    .hw-badge-add { background: #fff5f5; color: #c53030; }
    .hw-badge-std { background: #f7fafc; color: #4a5568; }
    .hw-actions { display: flex; gap: 5px; justify-content: flex-end; }
    .hw-action-btn { width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; background: #f8f9fc; color: #555; border: 1px solid #eef0f7; text-decoration: none; font-size: 11px; transition: all 0.15s; }
    .hw-action-btn:hover { background: #1a1a2e; color: #fff; border-color: #1a1a2e; text-decoration: none; }
    .hw-action-btn.danger:hover { background: #A32D2D; border-color: #A32D2D; color: #fff; }
    .hw-footer { padding: 10px 1.5rem; font-size: 12px; color: #aaa; border-top: 1px solid #f1f3f9; }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Ressources pédagogiques</p>
                <h1 class="hw-title">Exercices en Autonomie</h1>
            </div>
            <a asp-action="Create" class="hw-btn-new">
                <i class="fas fa-plus"></i> Nouvel exercice
            </a>
        </div>

        <div class="hw-toolbar">
            <input type="text" id="hwSearch" class="hw-search" placeholder="Rechercher un exercice...">
        </div>

        <div class="table-responsive">
            <table class="hw-table">
                <thead>
                    <tr>
                        <th>Dates (Ex. / Corr.)</th>
                        <th>Nom de l'exercice</th>
                        <th>Ressources</th>
                        <th>Type</th>
                        <th>Devoir lié</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="hwTableBody">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="hw-date-block">
                                    <span class="hw-date-ex"><i class="far fa-calendar-alt" style="margin-right:4px;"></i>@item.ExerciceDate.ToShortDateString()</span>
                                    <span class="hw-date-corr"><i class="fas fa-check-circle" style="margin-right:4px;"></i>@item.CorrectionDate.ToShortDateString()</span>
                                </div>
                            </td>
                            <td>
                                <div class="hw-exercice-name">@Html.DisplayFor(modelItem => item.ExerciceName)</div>
                                <div class="hw-sub">Formateur : @item.Teacher.Id</div>
                            </td>
                            <td>
                                <div class="hw-resource-icons">
                                    @if (!string.IsNullOrEmpty(item.ExerciceLink))
                                    {
                                        <a href="@item.ExerciceLink" target="_blank" class="hw-ricon hw-ricon-ex" title="Exercice"><i class="fas fa-file-alt"></i></a>
                                    }
                                    @if (!string.IsNullOrEmpty(item.AudioLink))
                                    {
                                        <a href="@item.AudioLink" target="_blank" class="hw-ricon hw-ricon-audio" title="Audio"><i class="fas fa-headphones"></i></a>
                                    }
                                    @if (!string.IsNullOrEmpty(item.CorrectionLink))
                                    {
                                        <a href="@item.CorrectionLink" target="_blank" class="hw-ricon hw-ricon-corr" title="Correction"><i class="fas fa-graduation-cap"></i></a>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (item.IsHomeworkAdditionnal)
                                {
                                    <span class="hw-badge hw-badge-add">Additionnel</span>
                                }
                                else
                                {
                                    <span class="hw-badge hw-badge-std">Standard</span>
                                }
                            </td>
                            <td style="font-size:12px; color:#555;">@item.HomeworkV2.HomeworkV2name</td>
                            <td>
                                <div class="hw-actions">
                                    <a asp-action="Edit" asp-route-id="@item.ExerciceId" class="hw-action-btn" title="Modifier"><i class="fas fa-pen"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.ExerciceId" class="hw-action-btn" title="Détails"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.ExerciceId" class="hw-action-btn danger" title="Supprimer"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="hw-footer" id="hwFooter"></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('hwSearch');
            var tbody = document.getElementById('hwTableBody');
            var footer = document.getElementById('hwFooter');
            var total = tbody.rows.length;

            function update() {
                var q = input.value.toLowerCase();
                var visible = 0;
                for (var i = 0; i < tbody.rows.length; i++) {
                    var match = tbody.rows[i].textContent.toLowerCase().indexOf(q) >= 0;
                    tbody.rows[i].style.display = match ? '' : 'none';
                    if (match) visible++;
                }
                footer.textContent = q ? (visible + ' résultat' + (visible !== 1 ? 's' : '') + ' sur ' + total) : (total + ' exercice' + (total !== 1 ? 's' : ''));
            }

            input.addEventListener('input', update);
            update();
        })();
    </script>
}
