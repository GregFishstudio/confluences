@model mvc.Models.Homework

@{
    ViewData["Title"] = "Détails du devoir";
    string userId = User.Claims
        .Where(c => c.Type == "sub")
        .SingleOrDefault()
        .Value;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }
    .hw-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
    .hw-topbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 1.5rem 1rem; border-bottom: 1px solid #f1f3f9; gap: 12px; flex-wrap: wrap; }
    .hw-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 4px; }
    .hw-title { font-family: 'Lora', serif; font-size: 22px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .hw-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #6c757d; text-decoration: none; border: 1px solid #eef0f7; border-radius: 10px; padding: 7px 14px; transition: all 0.15s; }
    .hw-back:hover { background: #f8f9fc; color: #1a1a2e; text-decoration: none; }
    .hw-body { padding: 1.5rem; }
    .hw-section-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #aaa; margin: 1.5rem 0 0.75rem; }
    .hw-dl { display: grid; grid-template-columns: 160px 1fr; gap: 0; margin-bottom: 1rem; }
    .hw-dt { font-size: 11px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: #aaa; padding: 10px 0; border-bottom: 1px solid #f1f3f9; display: flex; align-items: center; }
    .hw-dd { font-size: 13px; color: #1a1a2e; padding: 10px 0; border-bottom: 1px solid #f1f3f9; margin: 0; }
    .hw-student-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f1f3f9; flex-wrap: wrap; }
    .hw-link-green { font-size: 13px; color: #2c7a2e; text-decoration: none; font-weight: 500; }
    .hw-link-green:hover { text-decoration: underline; color: #2c7a2e; }
    .hw-link-red { font-size: 13px; color: #A32D2D; text-decoration: none; font-weight: 500; }
    .hw-link-red:hover { text-decoration: underline; color: #A32D2D; }
    .hw-file-label { display: inline-flex; align-items: center; gap: 6px; background: #f8f9fc; border: 1px dashed #c0c8e8; border-radius: 10px; padding: 7px 14px; font-size: 12px; color: #6c757d; cursor: pointer; transition: all 0.15s; }
    .hw-file-label:hover { background: #eef0f7; border-color: #a0a8d0; }
    .hw-submit-btn { display: inline-flex; align-items: center; gap: 6px; background: #1a1a2e; color: #fff; border: none; border-radius: 10px; padding: 8px 16px; font-size: 12px; font-weight: 500; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: opacity 0.15s; margin-top: 6px; }
    .hw-submit-btn:hover { opacity: 0.8; }
    .hw-upload-label { display: flex; align-items: center; justify-content: center; gap: 6px; background: #2c7a2e; color: #fff; border-radius: 10px; padding: 10px 18px; font-size: 13px; font-weight: 500; cursor: pointer; transition: opacity 0.15s; margin-top: 1rem; }
    .hw-upload-label:hover { opacity: 0.85; }
    .hw-badge-add { display: inline-block; background: #fff5f5; color: #c53030; border-radius: 8px; padding: 4px 10px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
    .hw-links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #f1f3f9; }
    .hw-link { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #6c757d; text-decoration: none; border: 1px solid #eef0f7; border-radius: 10px; padding: 7px 14px; transition: all 0.15s; }
    .hw-link:hover { background: #f8f9fc; color: #1a1a2e; text-decoration: none; }
    .hw-link.primary { background: #1a1a2e; color: #fff; border-color: #1a1a2e; }
    .hw-link.primary:hover { opacity: 0.8; color: #fff; }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Devoirs</p>
                <h1 class="hw-title">Devoir du @Model.HomeworkDate.ToString("dd MMMM yyyy")</h1>
            </div>
            <a asp-action="Index" class="hw-back">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>

        <div class="hw-body">

            @* ── Devoir de l'étudiant connecté ── *@
            @if (Model.HomeworkStudents.Where(h => h.StudentId == userId).Any())
            {
                <p class="hw-section-label">Mon devoir</p>
                @foreach (var item in Model.HomeworkStudents.Where(h => h.StudentId == userId).ToList())
                {
                    <div class="hw-student-row">
                        <a class="hw-link-green" href="@ViewData["URLAPI"]@item.HomeworkFile">
                            <i class="fas fa-file-alt" style="margin-right:4px;"></i>Consulter mon devoir
                        </a>
                        @if (string.IsNullOrEmpty(item.HomeworkFileTeacher))
                        {
                            <span style="font-size:12px; color:#aaa;">Pas de correction disponible</span>
                        }
                        else
                        {
                            <a class="hw-link-red" href="@ViewData["URLAPI"]@item.HomeworkFileTeacher">
                                <i class="fas fa-check-circle" style="margin-right:4px;"></i>Consulter la correction
                            </a>
                        }
                    </div>
                }
            }

            @* ── Vue formateur : devoirs des étudiants ── *@
            @if ((bool)ViewData["IsTeacher"] && Model.HomeworkStudents.Count() > 0)
            {
                <p class="hw-section-label">Devoirs rendus (@Model.HomeworkStudents.Count())</p>
                @foreach (var item in Model.HomeworkStudents.ToList())
                {
                    <div style="padding: 12px 0; border-bottom: 1px solid #f1f3f9;">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap;">
                            <a class="hw-link-green" href="@ViewData["URLAPI"]@item.HomeworkFile">
                                <i class="fas fa-user-graduate" style="margin-right:4px;"></i>Devoir de @item.Student.Firstname
                            </a>
                            @if (!string.IsNullOrEmpty(item.HomeworkFileTeacher))
                            {
                                <a class="hw-link-green" href="@ViewData["URLAPI"]@item.HomeworkFileTeacher">
                                    <i class="fas fa-check" style="margin-right:4px;"></i>Correction envoyée
                                </a>
                            }
                        </div>
                        <form asp-controller="HomeworkStudents" asp-action="Edit" enctype="multipart/form-data" style="margin-top:8px;">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="HomeworkId" value="@item.HomeworkId" />
                            <input type="hidden" name="HomeworkStudentId" value="@item.HomeworkStudentId" />
                            <label class="hw-file-label" for="correction-@item.HomeworkStudentId">
                                <i class="fas fa-paperclip"></i> Ajouter une correction
                                <input id="correction-@item.HomeworkStudentId" name="Pictures" type="file" style="display:none" onchange="this.closest('form').submit()">
                            </label>
                        </form>
                    </div>
                }
            }

            @* ── Infos générales ── *@
            <p class="hw-section-label" style="margin-top:1.5rem;">Informations</p>
            <div class="hw-dl">
                <span class="hw-dt">@Html.DisplayNameFor(model => model.Session)</span>
                <span class="hw-dd">@Model.Session.SchoolClassRoom.SchoolClassRoomName</span>

                <span class="hw-dt">@Html.DisplayNameFor(model => model.Teacher)</span>
                <span class="hw-dd">@Html.DisplayFor(model => model.Teacher.Firstname) @Html.DisplayFor(model => model.Teacher.LastName)</span>

                @if (!string.IsNullOrEmpty(Model.ClassLink))
                {
                    <span class="hw-dt">@Html.DisplayNameFor(model => model.ClassName)</span>
                    <span class="hw-dd">
                        <a href="@Model.ClassLink" target="_blank" style="color:#3182ce;">
                            @Html.DisplayFor(model => model.HomeworkType.HomeworkTypeName) : @Html.DisplayFor(model => model.ClassName)
                        </a>
                    </span>
                }

                <span class="hw-dt">@Html.DisplayNameFor(model => model.ExerciceName)</span>
                <span class="hw-dd">
                    <a href="@Model.ExerciceLink" target="_blank" style="color:#3182ce;">@Html.DisplayFor(model => model.ExerciceName)</a>
                </span>

                @if (Model.IsHomeworkAdditionnal)
                {
                    <span class="hw-dt">Type</span>
                    <span class="hw-dd"><span class="hw-badge-add">Devoir supplémentaire</span></span>
                }
            </div>

            @* ── Iframe exercice ── *@
            @if (!string.IsNullOrEmpty(Model.ClassLink))
            {
                <div class="embed-responsive embed-responsive-16by9" style="margin-bottom:1rem;">
                    <iframe class="embed-responsive-item" src="@Model.ClassLink" allowfullscreen></iframe>
                </div>
            }
            <div class="embed-responsive embed-responsive-16by9" style="margin-bottom:1rem;">
                <iframe class="embed-responsive-item" src="@Model.ExerciceLink" allowfullscreen></iframe>
            </div>

            @* ── Actions ── *@
            @if ((bool)ViewData["IsTeacher"])
            {
                <div class="hw-links">
                    <a asp-action="Edit" asp-route-id="@Model.HomeworkId" class="hw-link primary">
                        <i class="fas fa-pen"></i> Modifier
                    </a>
                    <a asp-action="Index" class="hw-link">Retour à la liste</a>
                </div>
            }
            else
            {
                <form asp-controller="HomeworkStudents" asp-action="Create" enctype="multipart/form-data" style="margin-top:1rem;">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="HomeworkId" value="@Model.HomeworkId" />
                    <label class="hw-upload-label" for="homeworkUpload">
                        <i class="fas fa-upload"></i> Rendre mon devoir
                        <input id="homeworkUpload" name="Pictures" type="file" style="display:none" onchange="this.closest('form').submit()">
                    </label>
                </form>
            }

        </div>
    </div>
</div>
