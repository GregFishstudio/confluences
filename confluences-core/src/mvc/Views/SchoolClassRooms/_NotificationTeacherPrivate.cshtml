@model mvc.Models.SchoolClassRoom

@{
    var teacherUserName = Model?.Sessions?.FirstOrDefault()?.SessionTeachers?.FirstOrDefault()?.Teacher?.UserName;
    var roomNameSafe = teacherUserName ?? string.Empty;
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    let audioContext;

    function initializeAudioContext() {
        if (!audioContext) {
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        playSong();
    }

    function playSong() {
        const notes = [
            { frequency: 261.63, duration: 0.3 }, { frequency: 329.63, duration: 0.3 },
            { frequency: 392.00, duration: 0.3 }, { frequency: 523.25, duration: 0.6 }
        ];
        let currentTime = audioContext.currentTime;
        notes.forEach(note => {
            playTone(audioContext, note.frequency, note.duration, currentTime);
            currentTime += note.duration;
        });
    }

    function playTone(audioContext, frequency, duration, startTime) {
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();
        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);
        oscillator.type = 'sine';
        oscillator.frequency.setValueAtTime(frequency, startTime);
        gainNode.gain.setValueAtTime(0.1, startTime); // Volume doux
        oscillator.start(startTime);
        oscillator.stop(startTime + duration);
    }

    document.addEventListener("DOMContentLoaded", function () {
        startConnectionPrivateJitsi().then(() => {
            
            privateJitsi.invoke("AddToGroup", "SchoolClassRoom_" + "@roomNameSafe").catch(function (err) {
                return console.error(err.toString());
            });

            // RÉCEPTION DE L'APPEL
            privateJitsi.on("JitsiPrivateNotification", function (message) {
                // 1. Lancer la musique (nécessite une interaction préalable sur la page)
                try { initializeAudioContext(); } catch(e) { console.log("Audio bloqué par le navigateur"); }

                // 2. Afficher la Modale Moderne
                Swal.fire({
                    title: 'Appel entrant !',
                    text: 'Votre formateur souhaite démarrer une visioconférence.',
                    icon: 'info',
                    background: '#ffffff',
                    showCancelButton: true,
                    confirmButtonColor: '#4e73df',
                    cancelButtonColor: '#e74a3b',
                    confirmButtonText: '<i class="fas fa-video"></i> Rejoindre',
                    cancelButtonText: 'Ignorer',
                    backdrop: `rgba(78, 115, 223, 0.2)`, // Voile bleu léger sur ton dégradé
                    allowOutsideClick: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("Private", "Jitsi", new { roomName = roomNameSafe, isPrivateRoom = false})';
                    }
                });
            });

            // ARRÊT DE L'APPEL (Fermer la modale si le formateur raccroche)
            privateJitsi.on("StopPrivateClassRoom", function (message) {
                if (Swal.isVisible()) {
                    Swal.close();
                }
            });
        });
    });
</script>

<style>
    /* On supprime les anciens styles cardBox pour ne plus avoir l'affichage moche */
    #notifBoxPrivate { display: none !important; }
</style>