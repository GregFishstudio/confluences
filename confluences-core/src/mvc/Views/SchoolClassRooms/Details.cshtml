@using mvc.Models
@model mvc.Models.SchoolClassRoom

@{
    ViewData["Title"] = Model.SchoolClassRoomName;
}

<partial name="_NotificationTeacherPrivate.cshtml" />

<style>
    :root {
        --bg-gradient: linear-gradient(135deg, #f0f4ff 0%, #f1fff5 50%, #ffffff 100%);
        --primary-modern: #4e73df;
        --secondary-modern: #224abe;
        --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    }

    body, .bgImage {
        background: var(--bg-gradient) !important;
        background-attachment: fixed !important;
        font-family: 'Inter', sans-serif;
        color: #2e3d49;
    }

    .header-glass {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
    }

    .session-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: var(--card-shadow);
        border: 1px solid rgba(0,0,0,0.05);
        margin-bottom: 3rem;
        overflow: hidden;
    }

    /* Boutons d'ajout (agrandis comme demandé) */
    .btn-add-user {
        padding: 0.6rem 1.2rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.9rem;
        transition: all 0.2s;
        background-color: rgba(78, 115, 223, 0.05);
        border: 1px solid rgba(78, 115, 223, 0.2);
        color: var(--primary-modern) !important;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-add-user:hover {
        background-color: var(--primary-modern);
        color: white !important;
        text-decoration: none;
        transform: translateY(-2px);
    }

    /* Correction des boutons d'action (Appeler/Supprimer) */
    .btn-circle-action {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        border: 1px solid #edf2f7;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        transition: all 0.2s;
    }

    .btn-circle-action:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 12px rgba(0,0,0,0.1);
    }

    .avatar-img {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        object-fit: cover;
        border: 2px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .admin-dock {
        background: #1a1c23;
        color: white;
        border-radius: 100px;
        padding: 0.75rem 2rem;
        position: sticky;
        bottom: 20px;
        z-index: 100;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .admin-dock a { color: #a0aec0; margin-right: 1.5rem; font-size: 0.85rem; }
    .admin-dock a:hover { color: white; text-decoration: none; }
</style>

<div class="container-fluid py-4 px-md-5">
    
    <div class="header-glass d-flex justify-content-between align-items-center">
        <h1 class="h2 font-weight-bold mb-0">@Model.SchoolClassRoomName</h1>
        <div class="d-flex gap-2">
            @if (Model.Sessions.Any()) {
                <a class="btn btn-primary rounded-pill px-4" href="@Url.Action("Index", "HomeworkV2s", new { id = Model.Sessions.FirstOrDefault().SessionId })">Devoirs</a>
            }
            <button class="btn btn-info rounded-pill px-4 text-white" onclick="window.open('@Url.Action("Index", "Jitsi", new { roomName = Model.SchoolClassRoomId, isPrivateRoom = false})', '_blank')">
                Salon Virtuel
            </button>
        </div>
    </div>

    @foreach (Session session in Model.Sessions.OrderByDescending(s => s.DateStart))
    {
        <div class="session-card">
            <div class="px-4 py-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                <span class="badge badge-primary px-3 py-2">Session @session.DateStart.Year</span>
                <div class="d-flex gap-2">
                    <a asp-controller="SessionTeachers" asp-action="Create" asp-route-id="@session.SessionId" class="btn-add-user">
                        <i class="fas fa-user-tie"></i> + Formateur
                    </a>
                    <a asp-controller="SessionStudents" asp-action="Create" asp-route-id="@session.SessionId" class="btn-add-user">
                        <i class="fas fa-user-graduate"></i> + Étudiant
                    </a>
                </div>
            </div>

            <div class="p-4">
                <div class="row">
                    <div class="col-lg-4 border-right">
                        <h6 class="font-weight-bold mb-4 text-uppercase small text-muted">Équipe Pédagogique</h6>
                        @foreach (SessionTeacher st in session.SessionTeachers.OrderBy(s => s.Order))
                        {
                            <div class="d-flex align-items-center mb-3 p-2 rounded shadow-sm border">
                                <div class="position-relative">
                                    <img class="avatar-img" src="@(st.Teacher.PathImage != null ? ViewData["URLAPI"] + st.Teacher.PathImage : Url.Content("~/img/avatar.jpg"))" />
                                    <i data-userconnected="@st.Teacher.UserName" class="userconnected fas fa-circle text-secondary position-absolute" style="bottom:0; right:0; border:2px solid white; border-radius:50%; font-size:12px;"></i>
                                </div>
                                <div class="ml-3 flex-grow-1">
                                    <div class="font-weight-bold">@st.Teacher.Firstname</div>
                                </div>
                                <div class="d-flex gap-2">
                                    <a data-userConnected="@st.Teacher.UserName" 
                                       href="@Url.Action("Private", "Jitsi", new { roomName = st.Teacher.UserName, isPrivateRoom = true})" 
                                       class="btn-circle-action callButton callUnAvailable">
                                        <img src="~/img/Conference.png" style="width: 25px;" />
                                    </a>
                                    <a asp-controller="SessionTeachers" asp-action="Delete" asp-route-id="@st.SessionId" asp-route-id2="@st.Teacher.Id" 
                                       class="btn-circle-action text-danger">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-lg-8">
                        <h6 class="font-weight-bold mb-4 text-uppercase small text-muted">Participants (@session.SessionStudents.Count())</h6>
                        <div class="row">
                            @foreach (SessionStudent ss in session.SessionStudents.OrderBy(s => s.Student.Firstname))
                            {
                                <div class="col-md-3 col-6 mb-4 text-center">
                                    <div class="position-relative d-inline-block">
                                        <img class="avatar-img" src="@(ss.Student.PathImage != null ? ViewData["URLAPI"] + ss.Student.PathImage : Url.Content("~/img/avatar.jpg"))" />
                                        <i data-userconnected="@ss.Student.UserName" class="userconnected fas fa-circle text-secondary position-absolute" style="bottom:0; right:0; border:2px solid white; border-radius:50%; font-size:10px;"></i>
                                    </div>
                                    <div class="small font-weight-bold mt-2">@ss.Student.Firstname</div>
                                    <div class="d-flex justify-content-center mt-2 gap-2">
                                        <a data-userConnected="@ss.Student.UserName" 
                                           href="@Url.Action("Private", "Jitsi", new { roomName = ss.Student.UserName, isPrivateRoom = true})" 
                                           class="callButton callUnAvailable text-primary" style="font-size: 1.2rem;">
                                            <i class="fas fa-phone-alt"></i>
                                        </a>
                                        <a asp-controller="SessionStudents" asp-action="Delete" asp-route-id="@ss.SessionId" asp-route-id2="@ss.Student.Id" 
                                           class="text-danger" style="font-size: 1.2rem;">
                                            <i class="fas fa-times-circle"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <partial name="../Chat/Chat.cshtml" />

    <div class="admin-dock d-flex justify-content-center mx-auto mt-5">
        <a asp-action="Edit" asp-route-id="@Model.SchoolClassRoomId">Configuration</a>
        <a asp-controller="SchoolClassRoomExplanations" asp-action="Index" asp-route-id="@Model.SchoolClassRoomId">Langues</a>
        <a id="Archived" class="text-danger font-weight-bold pointer">Archiver la classe</a>
    </div>
</div>

@section Scripts {
    <script>
        // Logique de scroll auto
        function updateScrollbar() {
            var messagesContent = document.querySelector(".messages-content");
            if (messagesContent) {
                messagesContent.scrollTop = messagesContent.scrollHeight;
            }
        }

        // SignalR : Réception des messages de chat
        connection.on("SendStudentMessage", function (message) {
            if (message.includes("Jitsi") || message.includes("rejoindre")) return;
            
            var newMessageDiv = document.createElement("div");
            newMessageDiv.className = "message message-personal new";
            newMessageDiv.textContent = message;
            newMessageDiv.style.background = "linear-gradient(120deg, #4e73df, #224abe)";

            var messagesContent = document.querySelector(".messages-content");
            if (messagesContent) {
                messagesContent.appendChild(newMessageDiv);
                updateScrollbar();
            }
        });

        // Envoi de message
        function insertMessage() {
            var msg = document.getElementById('messageInput').value;
            if ($.trim(msg) == '') return false;

            $.ajax({
                type: "POST",
                url: "/Chat/SendMessageToClassRoom",
                data: { message: msg, userName: '@(ViewData["CurrentUserName"])' }
            });

            document.getElementById('messageInput').value = '';
        }

        // Archivage
        document.getElementById("Archived").onclick = function () {
            if (confirm('Êtes-vous sûr de vouloir archiver cette classe ?')) {
                location.href='@Url.Action("archive", "SchoolClassRooms", new { id = Model.SchoolClassRoomId })';
            }
        };

        $(document).ready(function() { updateScrollbar(); });
    </script>
}