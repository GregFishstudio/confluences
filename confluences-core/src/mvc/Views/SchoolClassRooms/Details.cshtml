@using mvc.Models
@model mvc.Models.SchoolClassRoom

@{
    ViewData["Title"] = Model.SchoolClassRoomName;
}

<partial name="_NotificationTeacherPrivate.cshtml" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }

    /* ── Topbar ── */
    .hw-topbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 1.5rem 1rem; gap: 12px; flex-wrap: wrap; margin-bottom: 1.5rem; }
    .hw-title { font-family: 'Lora', serif; font-size: 26px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .hw-topbar-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .hw-btn { display: inline-flex; align-items: center; gap: 6px; border-radius: 10px; padding: 8px 16px; font-size: 13px; font-weight: 500; text-decoration: none; transition: all 0.15s; cursor: pointer; border: none; font-family: 'DM Sans', sans-serif; }
    .hw-btn-primary { background: #1a1a2e; color: #fff; }
    .hw-btn-primary:hover { opacity: 0.8; color: #fff; text-decoration: none; }
    .hw-btn-outline { background: #f8f9fc; color: #1a1a2e; border: 1px solid #eef0f7; }
    .hw-btn-outline:hover { background: #1a1a2e; color: #fff; text-decoration: none; }
    .hw-btn-teal { background: #0d9488; color: #fff; }
    .hw-btn-teal:hover { opacity: 0.85; color: #fff; text-decoration: none; }

    /* ── Session cards ── */
    .hw-session-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
    .hw-session-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; border-bottom: 1px solid #f1f3f9; background: #f8f9fc; flex-wrap: wrap; gap: 8px; }
    .hw-session-year { display: inline-block; background: #1a1a2e; color: #fff; border-radius: 8px; padding: 4px 12px; font-size: 12px; font-weight: 600; }
    .hw-session-del { font-size: 12px; color: #aaa; text-decoration: none; margin-left: 10px; transition: color 0.15s; }
    .hw-session-del:hover { color: #A32D2D; text-decoration: none; }
    .hw-session-btns { display: flex; gap: 6px; }
    .hw-session-body { display: grid; grid-template-columns: 280px 1fr; gap: 0; }
    @@media (max-width: 768px) { .hw-session-body { grid-template-columns: 1fr; } }
    .hw-team-col { padding: 1.25rem 1.5rem; border-right: 1px solid #f1f3f9; }
    .hw-students-col { padding: 1.25rem 1.5rem; }
    .hw-col-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #aaa; margin: 0 0 1rem; }

    /* ── Teacher row ── */
    .hw-teacher-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid #f1f3f9; }
    .hw-avatar { width: 46px; height: 46px; border-radius: 12px; object-fit: cover; border: 2px solid #f1f3f9; flex-shrink: 0; }
    .hw-teacher-name { font-size: 13px; font-weight: 500; color: #1a1a2e; flex: 1; }
    .hw-teacher-actions { display: flex; gap: 5px; }
    .hw-circle-btn { width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; background: #f8f9fc; border: 1px solid #eef0f7; color: #555; text-decoration: none; transition: all 0.15s; }
    .hw-circle-btn:hover { background: #1a1a2e; color: #fff; border-color: #1a1a2e; text-decoration: none; }
    .hw-circle-btn.danger:hover { background: #A32D2D; border-color: #A32D2D; color: #fff; }

    /* ── Student grid ── */
    .hw-students-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 12px; }
    .hw-student-card { text-align: center; }
    .hw-student-avatar { position: relative; display: inline-block; margin-bottom: 6px; }
    .hw-student-avatar img { width: 52px; height: 52px; border-radius: 12px; object-fit: cover; border: 2px solid #f1f3f9; }
    .hw-student-name { font-size: 11px; font-weight: 500; color: #1a1a2e; display: block; margin-bottom: 4px; }
    .hw-student-actions { display: flex; justify-content: center; gap: 5px; }
    .hw-student-btn { font-size: 12px; color: #aaa; text-decoration: none; transition: color 0.15s; }
    .hw-student-btn.call:hover { color: #1a1a2e; }
    .hw-student-btn.remove:hover { color: #A32D2D; }

    /* Connection dot */
    .hw-conn-dot { position: absolute; bottom: -2px; right: -2px; width: 12px; height: 12px; border-radius: 50%; background: #9ca3af; border: 2px solid #fff; }

    /* ── Admin dock ── */
    .hw-dock { background: #1a1a2e; color: #fff; border-radius: 100px; padding: 10px 24px; position: sticky; bottom: 20px; z-index: 100; box-shadow: 0 10px 30px rgba(0,0,0,0.3); display: flex; justify-content: center; gap: 20px; margin-top: 2rem; }
    .hw-dock a { color: rgba(255,255,255,0.6); font-size: 13px; text-decoration: none; transition: color 0.15s; }
    .hw-dock a:hover { color: #fff; text-decoration: none; }
    .hw-dock a.danger { color: #fc8181; }
    .hw-dock a.danger:hover { color: #feb2b2; }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">

    <div class="hw-topbar">
        <h1 class="hw-title">@Model.SchoolClassRoomName</h1>
        <div class="hw-topbar-actions">
            <a asp-controller="Sessions" asp-action="Create" asp-route-classRoomId="@Model.SchoolClassRoomId" class="hw-btn hw-btn-outline">
                <i class="fas fa-plus"></i> Nouvelle session
            </a>
            @if (Model.Sessions.Any())
            {
                <a href="@Url.Action("Index", "HomeworkV2s", new { id = Model.Sessions.FirstOrDefault().SessionId })" class="hw-btn hw-btn-outline">
                    <i class="fas fa-book"></i> Devoirs
                </a>
            }
            <button class="hw-btn hw-btn-teal" onclick="window.open('@Url.Action("Index", "Jitsi", new { roomName = Model.SchoolClassRoomId, isPrivateRoom = false})', '_blank')">
                <i class="fas fa-video"></i> Salon Virtuel
            </button>
        </div>
    </div>

    @foreach (Session session in Model.Sessions.OrderByDescending(s => s.DateStart))
    {
        <div class="hw-session-card">
            <div class="hw-session-header">
                <div style="display:flex; align-items:center; gap:10px;">
                    <span class="hw-session-year">Session @session.DateStart.Year</span>
                    <a asp-controller="Sessions" asp-action="Delete" asp-route-id="@session.SessionId"
                       class="hw-session-del"
                       onclick="return confirm('Confirmer la suppression de cette session ? Cela effacera tous les accès étudiants/formateurs rattachés.')">
                        <i class="fas fa-trash"></i> Supprimer
                    </a>
                </div>
                <div class="hw-session-btns">
                    <a asp-controller="SessionTeachers" asp-action="Create" asp-route-id="@session.SessionId" class="hw-btn hw-btn-outline" style="font-size:12px; padding:6px 12px;">
                        <i class="fas fa-user-tie"></i> + Formateur
                    </a>
                    <a asp-controller="SessionStudents" asp-action="Create" asp-route-id="@session.SessionId" class="hw-btn hw-btn-outline" style="font-size:12px; padding:6px 12px;">
                        <i class="fas fa-user-graduate"></i> + Étudiant
                    </a>
                </div>
            </div>

            <div class="hw-session-body">
                <div class="hw-team-col">
                    <p class="hw-col-label">Équipe Pédagogique</p>
                    @foreach (SessionTeacher st in session.SessionTeachers.OrderBy(s => s.Order))
                    {
                        <div class="hw-teacher-row">
                            <div style="position:relative;">
                                <img class="hw-avatar" src="@(st.Teacher.PathImage != null ? ViewData["URLAPI"] + st.Teacher.PathImage : Url.Content("~/img/avatar.jpg"))" />
                                <i data-userconnected="@st.Teacher.UserName" class="userconnected fas fa-circle hw-conn-dot"></i>
                            </div>
                            <span class="hw-teacher-name">@st.Teacher.Firstname</span>
                            <div class="hw-teacher-actions">
                                <a data-userConnected="@st.Teacher.UserName"
                                   href="@Url.Action("Private", "Jitsi", new { roomName = st.Teacher.UserName, isPrivateRoom = true})"
                                   class="hw-circle-btn callButton callUnAvailable" title="Appel vidéo">
                                    <img src="~/img/Conference.png" style="width:18px;" />
                                </a>
                                <a asp-controller="SessionTeachers" asp-action="Delete" asp-route-id="@st.SessionId" asp-route-id2="@st.Teacher.Id"
                                   class="hw-circle-btn danger" title="Retirer">
                                    <i class="fas fa-trash-alt" style="font-size:11px;"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <div class="hw-students-col">
                    <p class="hw-col-label">Participants (@session.SessionStudents.Count())</p>
                    <div class="hw-students-grid">
                        @foreach (SessionStudent ss in session.SessionStudents.OrderBy(s => s.Student.Firstname))
                        {
                            <div class="hw-student-card">
                                <div class="hw-student-avatar">
                                    <img src="@(ss.Student.PathImage != null ? ViewData["URLAPI"] + ss.Student.PathImage : Url.Content("~/img/avatar.jpg"))" />
                                    <i data-userconnected="@ss.Student.UserName" class="userconnected fas fa-circle hw-conn-dot"></i>
                                </div>
                                <span class="hw-student-name">@ss.Student.Firstname</span>
                                <div class="hw-student-actions">
                                    <a data-userConnected="@ss.Student.UserName"
                                       href="@Url.Action("Private", "Jitsi", new { roomName = ss.Student.UserName, isPrivateRoom = true})"
                                       class="hw-student-btn call callButton callUnAvailable" title="Appeler">
                                        <i class="fas fa-phone-alt"></i>
                                    </a>
                                    <a asp-controller="SessionStudents" asp-action="Delete" asp-route-id="@ss.SessionId" asp-route-id2="@ss.Student.Id"
                                       class="hw-student-btn remove" title="Retirer">
                                        <i class="fas fa-times-circle"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <partial name="../Chat/Chat.cshtml" />

    <div class="hw-dock">
        <a asp-action="Edit" asp-route-id="@Model.SchoolClassRoomId"><i class="fas fa-cog" style="margin-right:5px;"></i>Configuration</a>
        <a asp-controller="SchoolClassRoomExplanations" asp-action="Index" asp-route-id="@Model.SchoolClassRoomId"><i class="fas fa-language" style="margin-right:5px;"></i>Langues</a>
        <a id="Archived" class="danger" style="cursor:pointer;"><i class="fas fa-archive" style="margin-right:5px;"></i>Archiver</a>
    </div>

</div>

@section Scripts {
    <script>
        function updateScrollbar() {
            var messagesContent = document.querySelector(".messages-content");
            if (messagesContent) {
                messagesContent.scrollTop = messagesContent.scrollHeight;
            }
        }

        connection.on("SendStudentMessage", function (message) {
            if (message.includes("Jitsi") || message.includes("rejoindre")) return;
            var newMessageDiv = document.createElement("div");
            newMessageDiv.className = "message message-personal new";
            newMessageDiv.textContent = message;
            newMessageDiv.style.background = "linear-gradient(120deg, #4e73df, #224abe)";
            var messagesContent = document.querySelector(".messages-content");
            if (messagesContent) {
                messagesContent.appendChild(newMessageDiv);
                updateScrollbar();
            }
        });

        function insertMessage() {
            var msg = document.getElementById('messageInput').value;
            if ($.trim(msg) == '') return false;
            $.ajax({
                type: "POST",
                url: "/Chat/SendMessageToClassRoom",
                data: { message: msg, userName: '@(ViewData["CurrentUserName"])' }
            });
            document.getElementById('messageInput').value = '';
        }

        document.getElementById("Archived").onclick = function () {
            if (confirm('Êtes-vous sûr de vouloir archiver cette classe ?')) {
                location.href = '@Url.Action("archive", "SchoolClassRooms", new { id = Model.SchoolClassRoomId })';
            }
        };

        $(document).ready(function () { updateScrollbar(); });
    </script>
}
