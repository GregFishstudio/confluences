@model IEnumerable<mvc.Models.Session>

@{
    ViewData["Title"] = "Gestion des Sessions";
}

<style>
    :root {
        --primary-color: #4e73df;
        --card-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
    }

    body.bgImage {
        background-color: #f8f9fc;
        background-image: none !important;
    }

    .admin-card {
        background: #fff;
        border: none;
        border-radius: 0.75rem;
        box-shadow: var(--card-shadow);
        overflow: hidden;
    }

    .card-header-actions {
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e3e6f0;
    }

    .date-badge {
        font-weight: 600;
        color: #5a5c69;
        background: #eaecf4;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.85rem;
        display: inline-block;
    }

    .class-link {
        font-weight: 700;
        color: var(--primary-color);
        text-decoration: none;
    }

    .class-link:hover {
        text-decoration: underline;
    }

    .btn-action {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        transition: 0.2s;
    }
</style>

<div class="container-fluid dashboard-container mt-4 px-4">
    <div class="admin-card">
        <div class="card-header-actions">
            <div>
                <h2 class="font-weight-bold text-dark mb-1">@ViewData["Title"]</h2>
                <p class="text-muted mb-0">Planification et suivi des sessions de cours</p>
            </div>

            <a class="btn btn-success btn-icon-split shadow-sm" asp-action="Create">
                <span class="icon text-white-50">
                    <i class="fas fa-calendar-plus"></i>
                </span>
                <span class="text">Nouvelle session</span>
            </a>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="datatables" class="table custom-table" width="100%">
                    <thead>
                        <tr>
                            <th>Classe / Salle</th>
                            <th>Date de début</th>
                            <th>Date de fin</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="pl-4">
                                    <a class="class-link" asp-controller="SchoolClassRooms" asp-action="Details" asp-route-id="@item.SchoolClassRoomId">
                                        <i class="fas fa-university mr-2"></i>
                                        @Html.DisplayFor(modelItem => item.SchoolClassRoom.SchoolClassRoomName)
                                    </a>
                                </td>
                                <td>
                                    <span class="date-badge">
                                        <i class="far fa-calendar-alt mr-1 text-primary"></i>
                                        @item.DateStart.ToString("dd MMM yyyy")
                                    </span>
                                </td>
                                <td>
                                    <span class="date-badge">
                                        <i class="far fa-calendar-check mr-1 text-success"></i>
                                        @item.DateEnd.ToString("dd MMM yyyy")
                                    </span>
                                </td>
                                <td class="text-right pr-4">
                                    <a asp-action="Details" asp-route-id="@item.SessionId" class="btn btn-light btn-action mr-1" title="Détails">
                                        <i class="fas fa-eye text-info"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.SessionId" class="btn btn-light btn-action mr-1" title="Modifier">
                                        <i class="fas fa-pen text-primary"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.SessionId" class="btn btn-light btn-action text-danger" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#datatables').DataTable({
                "pagingType": "simple_numbers",
                "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Tout"]],
                responsive: true,
                language: {
                    "url": "//cdn.datatables.net/plug-ins/1.10.20/i18n/French.json",
                    searchPlaceholder: "Rechercher une session..."
                },
                "order": [[1, "desc"]], // Trie par date de début par défaut
                "columnDefs": [
                    { "orderable": false, "targets": 3 }
                ],
                "dom": "<'row px-4 pt-4'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                       "<'row'<'col-sm-12'tr>>" +
                       "<'row px-4 pb-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
}