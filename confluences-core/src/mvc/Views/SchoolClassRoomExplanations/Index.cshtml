@model IEnumerable<mvc.Models.SchoolClassRoomExplanation>

@{
    ViewData["Title"] = "Explications audio";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Lora:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap');
    .hw-root { font-family: 'DM Sans', sans-serif; }
    .hw-card { background: #fff; border-radius: 20px; border: 1px solid #f1f3f9; box-shadow: 0 4px 24px rgba(0,0,0,0.04); overflow: hidden; margin-bottom: 2rem; }
    .hw-topbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 1.5rem 1rem; border-bottom: 1px solid #f1f3f9; gap: 12px; flex-wrap: wrap; }
    .hw-eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #aaa; margin: 0 0 4px; }
    .hw-title { font-family: 'Lora', serif; font-size: 22px; font-weight: 600; color: #1a1a2e; margin: 0; }
    .hw-btn-new { display: inline-flex; align-items: center; gap: 6px; background: #1a1a2e; color: #fff; border-radius: 10px; padding: 9px 18px; font-size: 13px; font-weight: 500; text-decoration: none; transition: opacity 0.15s; white-space: nowrap; }
    .hw-btn-new:hover { opacity: 0.8; color: #fff; text-decoration: none; }
    .hw-toolbar { display: flex; align-items: center; gap: 10px; padding: 1rem 1.5rem; border-bottom: 1px solid #f1f3f9; }
    .hw-search { flex: 1; max-width: 320px; background: #f8f9fc; border: 1px solid #eef0f7; border-radius: 10px; padding: 8px 14px; font-size: 13px; color: #1a1a2e; font-family: 'DM Sans', sans-serif; outline: none; }
    .hw-search:focus { border-color: #c0c8e8; background: #fff; }
    .hw-table { width: 100%; border-collapse: collapse; }
    .hw-table thead th { font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #aaa; padding: 10px 1.5rem; border-bottom: 1px solid #f1f3f9; text-align: left; background: #f8f9fc; }
    .hw-table tbody tr { border-bottom: 1px solid #f1f3f9; transition: background 0.1s; }
    .hw-table tbody tr:hover { background: #fafbfe; }
    .hw-table tbody td { padding: 14px 1.5rem; font-size: 13px; color: #1a1a2e; vertical-align: middle; }
    .hw-lang-pill { display: inline-flex; align-items: center; gap: 7px; background: rgba(78,115,223,0.07); color: #1a1a2e; border-radius: 10px; padding: 5px 12px; font-weight: 600; font-size: 13px; }
    .hw-audio-link { font-size: 12px; color: #6c757d; word-break: break-all; }
    .hw-actions { display: flex; gap: 5px; justify-content: flex-end; }
    .hw-action-btn { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; background: #f8f9fc; color: #555; border: 1px solid #eef0f7; text-decoration: none; font-size: 12px; transition: all 0.15s; }
    .hw-action-btn:hover { background: #1a1a2e; color: #fff; border-color: #1a1a2e; text-decoration: none; }
    .hw-action-btn.danger:hover { background: #A32D2D; border-color: #A32D2D; color: #fff; }
    .hw-footer { padding: 10px 1.5rem; font-size: 12px; color: #aaa; border-top: 1px solid #f1f3f9; }
</style>

<div class="container-fluid py-4 px-md-4 hw-root">
    <div class="hw-card">

        <div class="hw-topbar">
            <div>
                <p class="hw-eyebrow">Classes</p>
                <h1 class="hw-title">
                    Explications audio
                    @if ((int)ViewData["SchoolClassRoomId"] != 0 && Model.Count() > 0)
                    {
                        <span style="font-weight:400; color:#aaa; font-size:18px;"> — @Model.First().SchoolClassRoom.SchoolClassRoomName</span>
                    }
                </h1>
            </div>
            @if ((int)ViewData["SchoolClassRoomId"] != 0)
            {
                <a asp-action="Create" asp-route-id="@ViewData["SchoolClassRoomId"]" class="hw-btn-new">
                    <i class="fas fa-plus"></i> Ajouter une explication
                </a>
            }
            else
            {
                <a asp-action="Create" class="hw-btn-new">
                    <i class="fas fa-plus"></i> Ajouter une explication
                </a>
            }
        </div>

        <div class="hw-toolbar">
            <input type="text" id="hwSearch" class="hw-search" placeholder="Rechercher...">
        </div>

        <div class="table-responsive">
            <table class="hw-table">
                <thead>
                    <tr>
                        <th>Langue</th>
                        <th>Lien audio</th>
                        <th>Classe</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="hwTableBody">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="hw-lang-pill"><i class="fas fa-language"></i> @Html.DisplayFor(modelItem => item.LanguageName)</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.AudioLink))
                                {
                                    <a href="@item.AudioLink" target="_blank" class="hw-audio-link"><i class="fas fa-volume-up" style="margin-right:4px;"></i>@item.AudioLink</a>
                                }
                                else
                                {
                                    <span style="color:#aaa; font-size:12px;">—</span>
                                }
                            </td>
                            <td style="font-size:13px; color:#555;">@Html.DisplayFor(modelItem => item.SchoolClassRoom.SchoolClassRoomName)</td>
                            <td>
                                <div class="hw-actions">
                                    <a asp-action="Edit" asp-route-id="@item.SchoolClassRoomExplanationId" class="hw-action-btn" title="Modifier"><i class="fas fa-pen"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.SchoolClassRoomExplanationId" class="hw-action-btn danger" title="Supprimer"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="hw-footer" id="hwFooter"></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('hwSearch');
            var tbody = document.getElementById('hwTableBody');
            var footer = document.getElementById('hwFooter');
            var total = tbody.rows.length;

            function update() {
                var q = input.value.toLowerCase();
                var visible = 0;
                for (var i = 0; i < tbody.rows.length; i++) {
                    var match = tbody.rows[i].textContent.toLowerCase().indexOf(q) >= 0;
                    tbody.rows[i].style.display = match ? '' : 'none';
                    if (match) visible++;
                }
                footer.textContent = q ? (visible + ' résultat' + (visible !== 1 ? 's' : '') + ' sur ' + total) : (total + ' explication' + (total !== 1 ? 's' : ''));
            }

            input.addEventListener('input', update);
            update();
        })();
    </script>
}
